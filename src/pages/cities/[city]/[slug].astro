---
import { marked } from 'marked';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CityPhotoGallery from '../../../components/CityPhotoGallery.astro';
import CityPlaceMap from '../../../components/CityPlaceMap.astro';
import { cityName } from '../../../data/cities';
import { formatDate } from '../../../lib/content';
import { getCityPlaceByRoute } from '../../../server/database';
import { getSession } from '../../../server/auth';

const city = Astro.params.city;
const slug = Astro.params.slug;
const place = city && slug ? await getCityPlaceByRoute(city, slug) : undefined;
if (!place) return Astro.redirect('/404');
const admin = await getSession(Astro.cookies);
const noteHtml = place.note ? marked.parse(place.note) : '';
const mapLink = `https://www.google.com/maps/search/?api=1&query=${place.lat},${place.lng}`;
const statusLabel = place.visitStatus === 'visited' ? '去过' : '想去';
---

<BaseLayout title={place.name}>
  <div class="container city-detail-shell">
    <div class="trip-top-actions">
      <a class="back-link" href={`/cities/?city=${place.city}`}>← 返回城市</a>
      {admin && <a class="admin-edit-link" href={`/admin/cities#${place.id}`}>编辑地点</a>}
    </div>

    <header class="article-header city-place-header">
      <p class="eyebrow">{cityName(place.city)}</p>
      <h1>{place.name}</h1>
      <div class="city-place-meta">
        <span class="city-status-badge">{statusLabel}</span>
        {place.favorite && <span class="city-favorite">★ 收藏</span>}
        <span>{place.type}</span>
        {place.district && <span>{place.district}</span>}
        {place.photos.length > 0 && <span>{place.photos.length} 张照片</span>}
      </div>
      {place.recommendation && <p class="city-recommendation">{place.recommendation}</p>}
    </header>

    {place.photos.length > 0 && (
      <section class="city-detail-gallery">
        <CityPhotoGallery photos={place.photos} />
      </section>
    )}

    <div class="city-detail-lower">
      <div class="city-detail-copy">
        <dl class="city-place-facts">
          {place.address && <div><dt>地址</dt><dd>{place.address}</dd></div>}
          {place.rating && <div><dt>评分</dt><dd>{place.rating} / 5</dd></div>}
          {place.lastVisitedAt && <div><dt>最后到访</dt><dd>{formatDate(new Date(`${place.lastVisitedAt}T00:00:00`))}</dd></div>}
          {place.relatedTrip && <div><dt>关联旅行</dt><dd><a href={`/travel/${place.relatedTrip.id}/`}>{place.relatedTrip.title} →</a></dd></div>}
        </dl>
        {place.tags.length > 0 && <div class="tag-list city-place-tags" aria-label="地点标签">{place.tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
        {noteHtml && <article class="prose city-place-note" set:html={noteHtml} />}
      </div>
      <div class="city-map-column">
        <CityPlaceMap name={place.name} lat={place.lat} lng={place.lng} />
        <a class="city-navigation-link" href={mapLink} target="_blank" rel="noreferrer">在地图中导航 ↗</a>
      </div>
    </div>
  </div>
</BaseLayout>
