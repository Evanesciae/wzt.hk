---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {env} from 'cloudflare:workers';
import {overview,type NtuEnv} from '../../server/ntu/service';
import {singapore} from '../../server/ntu/core';
import '../../styles/study.css';
if(!Astro.locals.adminSession)return Astro.redirect('/admin/login?next=%2Fadmin%2Fntu');
const data=await overview(env as unknown as NtuEnv);
const {config,configured,courses,items}=data;
const selected=new Set(config.courseIds);
const names=new Map(courses.map(c=>[c.id,c.name]));
const state=data.state as {last_success:string|null;error:string|null};
---
<BaseLayout title="NTULearn connection">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <div class="study-shell">
    <nav><a class="button" href="/admin/study">← NTU</a></nav>
    <header><h1>NTULearn connection <span class="badge">Private</span></h1><p class="muted">Connect NTULearn and choose your courses. Keep files and announcements here for future use by Muse.</p></header>
    <section class="panel" id="settings">
      <h2>1. Connect your account</h2>
      <p class="muted">{configured.cookie?'Login cookie saved. Update it here when it expires.':'Your NTULearn account is not connected yet.'}</p>
      {!data.encryptionReady&&<p class="error">Credential encryption is not ready. Please wait before entering a cookie.</p>}
      <form id="connection" data-revision={data.revision}>
        <label>NTULearn login cookie<input name="cookie" type="password" autocomplete="new-password" maxlength="8000" placeholder={configured.cookie?'Saved — leave blank to keep it':'Paste the BbRouter value'} /></label>
        <details><summary>Where do I find the cookie?</summary><p class="muted">Sign in to NTULearn in Chrome. On Mac, press Option + Command + I (Windows: F12). Open Application → Cookies → https://ntulearn.ntu.edu.sg, find BbRouter and paste its Value above. Your cookie is encrypted and never shown after saving.</p></details>
        <p><button type="button" data-courses disabled={!data.encryptionReady}>Save & load courses</button></p>
        <h2>2. Choose courses</h2>
        {courses.length?courses.map(c=><label><input type="checkbox" name="courseId" value={c.id} checked={selected.has(c.id)} /> {c.name}<span class="muted"> · {c.code}</span></label>):<p class="muted">Your courses will appear here after connecting.</p>}
        <h2>3. Course announcements</h2>
        <label><input name="enabled" type="checkbox" checked={config.enabled} /> Automatically sync announcements and calendar events</label>
        <label>Check frequency<select name="interval">{[30,60,120].map(n=><option value={n} selected={config.interval===n}>Every {n} minutes</option>)}</select></label>
        <p class="muted">Enable automatic file downloads on the NTU page.</p>
        <div class="row"><button type="submit" class="primary" disabled={!data.encryptionReady}>Save connection</button><a class="button" href="/admin/study">Go to course files →</a></div>
      </form>
    </section>
    <section class="panel"><div class="row"><h2>Announcements & calendar</h2><button type="button" data-sync disabled={!configured.cookie||!selected.size}>Refresh announcements</button></div>
      <p class="muted">{state.last_success?'Last updated: '+singapore(state.last_success):'No announcements synced yet.'}</p>{state.error&&<p class="error">{state.error}</p>}
      {!items.length&&<p class="muted">Original announcements and dates will appear here after syncing.</p>}
      {items.map(item=><article class="entry"><strong>{item.title}</strong><p class="muted">{names.get(item.course_id)??item.course_id}{item.due_at?' · '+singapore(item.due_at):''}</p><p class="body">{item.body||'Open NTULearn to view this item.'}</p><a href={item.source_url} target="_blank" rel="noopener noreferrer">View on NTULearn ↗</a></article>)}
    </section>
    <div id="feedback" role="status" aria-live="polite" hidden></div>
  </div>
</BaseLayout>
<script>
  const form=document.querySelector<HTMLFormElement>('#connection')!;
  const feedback=document.querySelector<HTMLElement>('#feedback')!;
  const csrf=document.querySelector<HTMLMetaElement>('meta[name="csrf-token"]')?.content??'';
  let busy=false;
  async function api(body:Record<string,unknown>){
    const r=await fetch('/api/admin/ntu',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify(body)});
    const result=await r.json();if(!r.ok)throw new Error(result.error||'Could not save. Please try again.');return result;
  }
  async function save(){
    const d=new FormData(form);
    const result=await api({action:'school-save',revision:Number(form.dataset.revision),courseIds:d.getAll('courseId'),cookie:d.get('cookie'),enabled:d.has('enabled'),interval:Number(d.get('interval'))});
    form.dataset.revision=String(result.revision);
    (form.elements.namedItem('cookie') as HTMLInputElement).value='';
  }
  async function perform(action:()=>Promise<void>){
    if(busy)return;busy=true;feedback.hidden=false;feedback.textContent='Working…';
    try{await action();location.reload();}catch(error){feedback.textContent=error instanceof Error?error.message:'Connection failed. Please try again.';}finally{busy=false;}
  }
  form.addEventListener('submit',e=>{e.preventDefault();void perform(save);});
  document.querySelector('[data-courses]')?.addEventListener('click',()=>void perform(async()=>{await save();await api({action:'courses'});}));
  document.querySelector('[data-sync]')?.addEventListener('click',()=>void perform(async()=>{await api({action:'sync'});}));
</script>
