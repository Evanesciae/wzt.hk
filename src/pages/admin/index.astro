---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listTrips } from '../../server/database';

const trips = await listTrips(true);
---

<BaseLayout title="管理中心">
  <div class="container page-shell admin-dashboard">
    <header class="admin-heading">
      <div>
        <p class="eyebrow">ADMIN</p>
        <h1>管理中心</h1>
        <p class="admin-heading-description">集中管理网站内容和旅行记录。</p>
      </div>
      <div class="admin-heading-actions">
        <button type="button" class="primary-button admin-primary-action" data-new-trip>新建行程</button>
        <button type="button" class="text-button" data-logout>退出登录</button>
      </div>
    </header>

    <nav class="admin-module-grid" aria-label="管理功能">
      <a class="admin-module-card" href="/admin/kb">
        <span class="admin-module-icon" aria-hidden="true">文</span>
        <span><strong>知识库</strong><small>撰写与整理知识笔记</small></span>
        <span class="admin-module-arrow" aria-hidden="true">→</span>
      </a>
      <a class="admin-module-card" href="/admin/flights">
        <span class="admin-module-icon" aria-hidden="true">飞</span>
        <span><strong>航班记录</strong><small>录入足迹地图中的航班信息</small></span>
        <span class="admin-module-arrow" aria-hidden="true">→</span>
      </a>
      <a class="admin-module-card" href="/admin/airports">
        <span class="admin-module-icon" aria-hidden="true">港</span>
        <span><strong>机场资料</strong><small>管理机场代码与位置</small></span>
        <span class="admin-module-arrow" aria-hidden="true">→</span>
      </a>
    </nav>

    <section class="admin-content-section">
      <div class="admin-section-heading">
        <div>
          <p class="eyebrow">TRAVEL</p>
          <h2>旅行行程</h2>
        </div>
        <a class="text-button" href="/admin/travel/generate">AI 生成行程 →</a>
      </div>
      <div class="admin-trip-list">
        {trips.map((trip) => (
          <div class="admin-trip-row">
            <a href={`/admin/travel/${trip.id}`}>
              <div><strong>{trip.title}</strong><span>{trip.destination}</span></div>
              <span>编辑 →</span>
            </a>
            <button type="button" class="text-button admin-trip-delete" data-delete-trip={trip.id} data-trip-title={trip.title}>删除</button>
          </div>
        ))}
      </div>
      {trips.length === 0 && <p class="admin-empty-state">还没有行程。点击右上角“新建行程”开始记录。</p>}
    </section>
  </div>

  <dialog class="event-editor-dialog" data-trip-dialog>
    <form method="dialog" data-trip-form>
      <header><div><p class="eyebrow">NEW TRIP</p><h2>新建行程</h2></div><button type="button" data-dialog-close>×</button></header>
      <div class="form-grid">
        <label class="full">网址标识（英文/数字/连字符，用于 URL）<input name="id" required maxlength="80" placeholder="例如 taiwan-2024" /></label>
        <label class="full">标题<input name="title" required maxlength="120" /></label>
        <label>目的地<input name="destination" required /></label>
        <label>状态<select name="status"><option value="planning">计划中</option><option value="upcoming">即将出发</option><option value="archived">已归档</option></select></label>
        <label class="full form-check-inline"><input name="datesTbd" type="checkbox" /><span>日期待定（只按 Day 顺序规划）</span></label>
        <label data-trip-date-field>开始日期<input name="startDate" type="date" required /></label>
        <label data-trip-date-field>结束日期<input name="endDate" type="date" required /></label>
        <label class="full">摘要<input name="summary" required /></label>
      </div>
      <p class="form-error" data-trip-error hidden></p>
      <footer><button type="button" class="text-button" data-dialog-close>取消</button><button type="submit" class="primary-button">创建</button></footer>
    </form>
  </dialog>
</BaseLayout>

<script>
  // @ts-nocheck
  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ?? '';
  const api = async (url, options = {}) => fetch(url, { ...options, headers: { ...(options.headers || {}), 'x-csrf-token': csrf } });
  document.querySelectorAll('[data-dialog-close]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));

  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    await api('/api/admin/logout', { method: 'POST' });
    window.location.href = '/admin/login';
  });

  const dialog = document.querySelector('[data-trip-dialog]');
  const form = dialog?.querySelector('[data-trip-form]');
  const error = dialog?.querySelector('[data-trip-error]');
  const syncDateFields = () => {
    const datesTbd = form.elements.datesTbd.checked;
    form.querySelectorAll('[data-trip-date-field]').forEach((field) => field.hidden = datesTbd);
    form.elements.startDate.required = !datesTbd;
    form.elements.endDate.required = !datesTbd;
  };
  form?.elements.datesTbd?.addEventListener('change', syncDateFields);
  document.querySelector('[data-new-trip]')?.addEventListener('click', () => { form.reset(); syncDateFields(); error.hidden = true; dialog.showModal(); });
  form?.addEventListener('submit', async (submitEvent) => {
    submitEvent.preventDefault(); error.hidden = true;
    const data = new FormData(form);
    const body = {
      id: data.get('id'), title: data.get('title'), destination: data.get('destination'), status: data.get('status'),
      datesTbd: form.elements.datesTbd.checked, startDate: data.get('startDate'), endDate: data.get('endDate'), summary: data.get('summary'),
    };
    const response = await api('/api/admin/trips', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    if (response.ok) { const result = await response.json(); window.location.href = `/admin/travel/${result.id}`; }
    else { const result = await response.json().catch(() => ({})); error.textContent = `创建失败：${result.error ?? response.status}`; error.hidden = false; }
  });

  document.querySelectorAll('[data-delete-trip]').forEach((button) => button.addEventListener('click', async () => {
    if (!confirm(`删除“${button.dataset.tripTitle}”及其全部日期、模块和照片？`)) return;
    const response = await api(`/api/admin/trips/${button.dataset.deleteTrip}`, { method: 'DELETE' });
    if (response.ok) window.location.reload(); else alert('删除失败。');
  }));
</script>
