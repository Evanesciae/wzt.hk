---
import 'maplibre-gl/dist/maplibre-gl.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cities, cityName } from '../../data/cities';
import { listCityPlaces } from '../../server/database';

const places = await listCityPlaces(true);
---

<BaseLayout title="城市地点管理">
  <div class="container page-shell admin-dashboard">
    <div class="admin-heading">
      <div><a class="back-link" href="/admin/">← 管理中心</a><p class="eyebrow">CITY PLACES</p><h1>城市地点</h1></div>
      <div class="admin-heading-actions">
        <button type="button" class="text-button" data-new-place>新建地点</button>
        <a class="text-button" href="/cities/" target="_blank">查看公开页面 ↗</a>
      </div>
    </div>

    <div class="admin-city-list">
      {places.map((place, index) => (
        <article
          class="admin-city-card"
          id={place.id}
          data-city-place
          data-place={JSON.stringify({
            id: place.id,
            city: place.city,
            name: place.name,
            type: place.type,
            district: place.district,
            lat: place.lat,
            lng: place.lng,
            note: place.note,
            draft: place.draft,
          })}
          data-photo-dropzone
        >
          <div class="admin-event-order">{String(index + 1).padStart(2, '0')}</div>
          <div class="admin-event-content">
            <span class="admin-event-type">{cityName(place.city)} · {place.type}{place.draft ? ' · 草稿' : ''}</span>
            <h3>{place.name}</h3>
            <div class="admin-event-meta">
              {place.district && <span>{place.district}</span>}
              <span>{place.photos.length} 张照片</span>
              <span>{place.lat.toFixed(4)}, {place.lng.toFixed(4)}</span>
            </div>
            {place.photos.length > 0 && (
              <div class="admin-photo-strip" data-photo-strip>
                {place.photos.map((photo) => {
                  const thumb = [...photo.variants].sort((a, b) => a.width - b.width)[0];
                  return thumb && (
                    <span class:list={['admin-photo-item', photo.featured && 'is-cover']} draggable="true" data-photo-id={photo.id}>
                      <img src={`/media/${thumb.path}`} alt={photo.alt} loading="lazy" />
                      <button type="button" class="admin-photo-delete" data-delete-city-photo={photo.id} title="删除照片">×</button>
                      {!photo.featured && <button type="button" class="admin-photo-cover" data-set-cover={photo.id}>设为封面</button>}
                    </span>
                  );
                })}
              </div>
            )}
          </div>
          <div class="admin-city-actions">
            <button type="button" data-upload-trigger>＋ 照片</button>
            <button type="button" data-edit-place>编辑</button>
            <a href={`/cities/${place.city}/${place.id}/`} target="_blank">查看</a>
            <button type="button" data-delete-place>删除</button>
            <input type="file" accept="image/jpeg,image/png,image/webp,image/tiff,image/heic,image/heif,.heic,.heif" multiple data-photo-input hidden />
          </div>
          <div class="upload-status" data-upload-status hidden>
            <div><span data-upload-text></span><strong data-upload-percent>0%</strong></div>
            <div class="upload-progress-track"><i data-upload-progress></i></div>
          </div>
          <div class="photo-drop-overlay" aria-hidden="true"><span>＋</span><strong>拖到这里添加照片</strong><small>支持多张原图</small></div>
        </article>
      ))}
    </div>

    {places.length === 0 && <p class="filter-empty">暂无地点</p>}
  </div>

  <dialog class="event-editor-dialog" data-place-dialog>
    <form method="dialog" data-place-form>
      <header><div><p class="eyebrow">CITY PLACE</p><h2 data-place-dialog-title>新建地点</h2></div><button type="button" data-dialog-close>×</button></header>
      <input type="hidden" name="currentId" />
      <div class="form-grid">
        <label class="full" data-place-id-field>网址标识<input name="id" required maxlength="80" /></label>
        <label>城市<select name="city">{cities.map((city) => <option value={city.slug}>{city.name}</option>)}</select></label>
        <label>名称<input name="name" required maxlength="120" /></label>
        <label>类型<input name="type" required maxlength="60" /></label>
        <label>所属区域<input name="district" maxlength="80" /></label>
        <label>纬度<input name="lat" type="number" step="any" required /></label>
        <label>经度<input name="lng" type="number" step="any" required /></label>
        <div class="full geo-picker">
          <label class="geo-search-label">地图选点<input name="geoSearch" data-geo-search autocomplete="off" /></label>
          <ul class="geo-results" data-geo-results hidden></ul>
          <div class="geo-map" data-geo-map data-city-centers={JSON.stringify(Object.fromEntries(cities.map((city) => [city.slug, city.center])))}></div>
        </div>
        <label class="full">文字（可选）<textarea name="note" rows="5"></textarea></label>
        <label class="full form-checks"><label><input name="draft" type="checkbox" /><span>草稿</span></label></label>
      </div>
      <p class="form-error" data-place-error hidden></p>
      <footer><button type="button" class="text-button" data-dialog-close>取消</button><button type="submit" class="primary-button">保存</button></footer>
    </form>
  </dialog>
</BaseLayout>

<script>
  // @ts-nocheck
  import { preparePhotoUploads } from '../../lib/prepare-photo-uploads';

  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ?? '';
  const api = async (url, options = {}) => fetch(url, { ...options, headers: { ...(options.headers || {}), 'x-csrf-token': csrf } });
  const dialog = document.querySelector('[data-place-dialog]');
  const form = dialog?.querySelector('[data-place-form]');
  const dialogTitle = dialog?.querySelector('[data-place-dialog-title]');
  const idField = dialog?.querySelector('[data-place-id-field]');
  const error = dialog?.querySelector('[data-place-error]');
  document.querySelectorAll('[data-dialog-close]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));

  const geoMapElement = dialog?.querySelector('[data-geo-map]');
  const geoSearch = dialog?.querySelector('[data-geo-search]');
  const geoResults = dialog?.querySelector('[data-geo-results]');
  const cityCenters = JSON.parse(geoMapElement?.dataset.cityCenters ?? '{}');
  let geoMap;
  let geoMarker;

  async function openGeoMap() {
    if (!geoMapElement) return;
    if (!geoMap) {
      const { default: maplibregl } = await import('maplibre-gl');
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const center = cityCenters[form.elements.city.value] ?? [114.17, 22.32];
      geoMap = new maplibregl.Map({
        container: geoMapElement,
        style: `https://tiles.openfreemap.org/styles/${dark ? 'dark' : 'positron'}`,
        center,
        zoom: 10,
      });
      geoMap.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
      geoMarker = new maplibregl.Marker({ draggable: true });
      geoMarker.on('dragend', () => {
        const point = geoMarker.getLngLat();
        form.elements.lat.value = point.lat.toFixed(6);
        form.elements.lng.value = point.lng.toFixed(6);
      });
      geoMap.on('click', (event) => {
        geoMarker.setLngLat(event.lngLat).addTo(geoMap);
        form.elements.lat.value = event.lngLat.lat.toFixed(6);
        form.elements.lng.value = event.lngLat.lng.toFixed(6);
      });
    }
    setTimeout(() => {
      geoMap.resize();
      const lat = Number(form.elements.lat.value);
      const lng = Number(form.elements.lng.value);
      if (Number.isFinite(lat) && Number.isFinite(lng) && (lat || lng)) {
        geoMarker.setLngLat([lng, lat]).addTo(geoMap);
        geoMap.easeTo({ center: [lng, lat], zoom: 13, duration: 0 });
      } else {
        geoMarker.remove();
        geoMap.easeTo({ center: cityCenters[form.elements.city.value], zoom: 10, duration: 0 });
      }
    }, 80);
  }

  form?.elements.city.addEventListener('change', () => {
    if (!form.elements.lat.value && geoMap) geoMap.easeTo({ center: cityCenters[form.elements.city.value], zoom: 10 });
  });
  for (const key of ['lat', 'lng']) form?.elements[key].addEventListener('change', openGeoMap);
  geoSearch?.addEventListener('keydown', async (event) => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    const query = geoSearch.value.trim();
    if (!query) return;
    geoResults.hidden = false;
    geoResults.innerHTML = '<li><button type="button" disabled>搜索中…</button></li>';
    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=5&accept-language=zh&q=${encodeURIComponent(query)}`);
      const results = await response.json();
      geoResults.innerHTML = '';
      if (!results.length) geoResults.innerHTML = '<li><button type="button" disabled>没有结果</button></li>';
      results.forEach((result) => {
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = result.display_name;
        button.addEventListener('click', () => {
          const lat = Number(result.lat);
          const lng = Number(result.lon);
          form.elements.lat.value = lat.toFixed(6);
          form.elements.lng.value = lng.toFixed(6);
          geoMarker.setLngLat([lng, lat]).addTo(geoMap);
          geoMap.easeTo({ center: [lng, lat], zoom: 14 });
          geoResults.hidden = true;
        });
        item.append(button);
        geoResults.append(item);
      });
    } catch {
      geoResults.innerHTML = '<li><button type="button" disabled>搜索失败</button></li>';
    }
  });

  document.querySelector('[data-new-place]')?.addEventListener('click', () => {
    form.reset();
    form.elements.currentId.value = '';
    idField.hidden = false;
    form.elements.id.required = true;
    dialogTitle.textContent = '新建地点';
    error.hidden = true;
    dialog.showModal();
    openGeoMap();
  });

  document.querySelectorAll('[data-edit-place]').forEach((button) => button.addEventListener('click', () => {
    const place = JSON.parse(button.closest('[data-place]').dataset.place);
    form.reset();
    form.elements.currentId.value = place.id;
    form.elements.id.value = place.id;
    idField.hidden = true;
    form.elements.id.required = false;
    for (const key of ['city', 'name', 'type', 'district', 'lat', 'lng', 'note']) form.elements[key].value = place[key] ?? '';
    form.elements.draft.checked = Boolean(place.draft);
    dialogTitle.textContent = '编辑地点';
    error.hidden = true;
    dialog.showModal();
    openGeoMap();
  }));

  form?.addEventListener('submit', async (submitEvent) => {
    submitEvent.preventDefault();
    error.hidden = true;
    const data = new FormData(form);
    const currentId = String(data.get('currentId') ?? '');
    const body = {
      id: data.get('id'),
      city: data.get('city'),
      name: data.get('name'),
      type: data.get('type'),
      district: data.get('district'),
      lat: data.get('lat'),
      lng: data.get('lng'),
      note: data.get('note'),
      draft: form.elements.draft.checked,
    };
    const response = await api(currentId ? `/api/admin/cities/${currentId}` : '/api/admin/cities', {
      method: currentId ? 'PATCH' : 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (response.ok) window.location.reload();
    else {
      const result = await response.json().catch(() => ({}));
      error.textContent = `保存失败：${result.error ?? response.status}`;
      error.hidden = false;
    }
  });

  document.querySelectorAll('[data-delete-place]').forEach((button) => button.addEventListener('click', async () => {
    const card = button.closest('[data-place]');
    const place = JSON.parse(card.dataset.place);
    if (!confirm(`删除“${place.name}”及其全部照片？`)) return;
    const response = await api(`/api/admin/cities/${place.id}`, { method: 'DELETE' });
    if (response.ok) window.location.reload();
    else alert('删除失败。');
  }));

  document.querySelectorAll('[data-delete-city-photo]').forEach((button) => button.addEventListener('click', async (event) => {
    event.stopPropagation();
    if (!confirm('删除这张照片？')) return;
    const response = await api(`/api/admin/city-photos/${button.dataset.deleteCityPhoto}`, { method: 'DELETE' });
    if (response.ok) window.location.reload();
    else alert('删除失败。');
  }));

  document.querySelectorAll('[data-set-cover]').forEach((button) => button.addEventListener('click', async (event) => {
    event.stopPropagation();
    const response = await api(`/api/admin/city-photos/${button.dataset.setCover}`, {
      method: 'PATCH',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ featured: true }),
    });
    if (response.ok) window.location.reload();
    else alert('封面设置失败。');
  }));

  const orderOf = (strip) => [...strip.querySelectorAll('[data-photo-id]')].map((item) => item.dataset.photoId);
  document.querySelectorAll('[data-photo-strip]').forEach((strip) => {
    let dragId = null;
    let startOrder = null;
    strip.querySelectorAll('[data-photo-id]').forEach((item) => {
      item.addEventListener('dragstart', (event) => {
        dragId = item.dataset.photoId;
        startOrder = orderOf(strip);
        item.classList.add('is-dragging-photo');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', dragId);
      });
      item.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (!dragId || item.dataset.photoId === dragId) return;
        const rect = item.getBoundingClientRect();
        const dragging = strip.querySelector(`[data-photo-id="${CSS.escape(dragId)}"]`);
        strip.insertBefore(dragging, event.clientX > rect.left + rect.width / 2 ? item.nextSibling : item);
      });
    });
    strip.addEventListener('dragend', async () => {
      strip.querySelectorAll('.is-dragging-photo').forEach((item) => item.classList.remove('is-dragging-photo'));
      const nextOrder = orderOf(strip);
      if (!dragId || !startOrder || nextOrder.join(',') === startOrder.join(',')) return;
      const place = JSON.parse(strip.closest('[data-place]').dataset.place);
      const response = await api(`/api/admin/cities/${place.id}/photos/order`, {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ photoIds: nextOrder }),
      });
      if (response.ok) window.location.reload();
      else alert('排序保存失败。');
    });
  });

  async function uploadFiles(card, incomingFiles) {
    if (!card || card.dataset.uploading === 'true') return;
    const files = [...incomingFiles].filter((file) => file.type.startsWith('image/') || /\.(jpe?g|png|webp|tiff?|heic|heif)$/i.test(file.name));
    const status = card.querySelector('[data-upload-status]');
    const statusText = status.querySelector('[data-upload-text]');
    const percentText = status.querySelector('[data-upload-percent]');
    const progressBar = status.querySelector('[data-upload-progress]');
    const updateProgress = (percent, text) => {
      const value = Math.max(0, Math.min(100, Math.round(percent)));
      progressBar.style.width = `${value}%`;
      percentText.textContent = `${value}%`;
      statusText.textContent = text;
    };
    status.hidden = false;
    if (files.length === 0) { updateProgress(0, '没有检测到支持的图片文件。'); return; }
    if (files.length > 30) { updateProgress(0, '每次最多上传 30 张照片。'); return; }
    const oversized = files.find((file) => file.size > 100 * 1024 * 1024);
    if (oversized) { updateProgress(0, `${oversized.name} 超过 100 MB。`); return; }
    const place = JSON.parse(card.dataset.place);
    card.dataset.uploading = 'true';
    card.classList.add('is-uploading');
    const finishWithError = (message) => {
      updateProgress(Number(percentText.textContent?.replace('%', '')) || 0, message);
      card.dataset.uploading = 'false';
      card.classList.remove('is-uploading');
    };
    updateProgress(0, `准备上传 ${files.length} 张照片…`);
    let prepared;
    try {
      prepared = await preparePhotoUploads(files, ({ index, total, fileName }) => {
        updateProgress(index / total * 15, `图片超过处理限制，正在压缩：${fileName}`);
      });
    } catch (error) {
      finishWithError(error instanceof Error ? error.message : '图片压缩失败。');
      return;
    }
    if (prepared.compressedCount > 0) {
      const saved = ((prepared.originalBytes - prepared.preparedBytes) / 1024 / 1024).toFixed(1);
      updateProgress(15, `已按需压缩 ${prepared.compressedCount} 张，减少 ${saved} MB。`);
    }
    const data = new FormData();
    prepared.files.forEach((file) => data.append('photos', file));
    const xhr = new XMLHttpRequest();
    let streamOffset = 0;
    let streamBuffer = '';
    let completed = false;
    const handleMessage = (message) => {
      if (message.type === 'progress') {
        const visual = 40 + Number(message.overall ?? 0) * .6;
        let label = `正在处理第 ${message.fileIndex}/${message.totalFiles} 张：${message.fileName}`;
        if (message.stage === 'resizing' && message.width) label += ` · 生成 ${message.width}px`;
        updateProgress(visual, label);
      } else if (message.type === 'complete') {
        completed = true;
        updateProgress(100, '处理完成，正在刷新…');
      } else if (message.type === 'error') {
        finishWithError(`处理失败：${message.error ?? '未知错误'}`);
      }
    };
    const readStream = () => {
      streamBuffer += xhr.responseText.slice(streamOffset);
      streamOffset = xhr.responseText.length;
      const messages = streamBuffer.split('\n\n');
      streamBuffer = messages.pop() ?? '';
      messages.forEach((block) => {
        const dataLine = block.split('\n').find((line) => line.startsWith('data: '));
        if (dataLine) { try { handleMessage(JSON.parse(dataLine.slice(6))); } catch {} }
      });
    };
    xhr.open('POST', `/api/admin/cities/${place.id}/photos`);
    xhr.setRequestHeader('x-csrf-token', csrf);
    xhr.timeout = 30 * 60 * 1000;
    xhr.upload.addEventListener('progress', (progressEvent) => {
      if (!progressEvent.lengthComputable) return;
      updateProgress(15 + progressEvent.loaded / progressEvent.total * 25, '正在上传照片…');
    });
    xhr.addEventListener('progress', readStream);
    xhr.addEventListener('load', () => {
      readStream();
      if (completed) setTimeout(() => window.location.reload(), 250);
      else finishWithError(`上传失败：HTTP ${xhr.status}`);
    });
    xhr.addEventListener('error', () => finishWithError('网络连接中断。'));
    xhr.addEventListener('timeout', () => finishWithError('处理超时。'));
    xhr.send(data);
  }

  document.querySelectorAll('[data-upload-trigger]').forEach((button) => button.addEventListener('click', () => button.closest('[data-place]')?.querySelector('[data-photo-input]')?.click()));
  document.querySelectorAll('[data-photo-input]').forEach((input) => input.addEventListener('change', () => {
    if (input.files?.length) uploadFiles(input.closest('[data-place]'), input.files);
  }));
  document.querySelectorAll('[data-photo-dropzone]').forEach((card) => {
    let dragDepth = 0;
    const hasFiles = (event) => event.dataTransfer?.types?.includes('Files');
    card.addEventListener('dragenter', (event) => {
      if (!hasFiles(event)) return;
      event.preventDefault();
      dragDepth += 1;
      card.classList.add('is-dragging');
    });
    card.addEventListener('dragover', (event) => {
      if (!hasFiles(event)) return;
      event.preventDefault();
      event.dataTransfer.dropEffect = 'copy';
    });
    card.addEventListener('dragleave', (event) => {
      if (!hasFiles(event)) return;
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) card.classList.remove('is-dragging');
    });
    card.addEventListener('drop', (event) => {
      if (!hasFiles(event)) return;
      event.preventDefault();
      dragDepth = 0;
      card.classList.remove('is-dragging');
      if (event.dataTransfer?.files?.length) uploadFiles(card, event.dataTransfer.files);
    });
  });
</script>
