---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {env} from 'cloudflare:workers';
import {config,type StudyEnv,type Source} from '../../../server/study';
import {singapore} from '../../../server/ntu/core';
import '../../../styles/study.css';
if(!Astro.locals.adminSession)return Astro.redirect('/admin/login?next=%2Fadmin%2Fstudy');
const e=env as unknown as StudyEnv,c=await config(e);
const page=Math.max(0,Math.min(1000,Number(Astro.url.searchParams.get('page'))||0));
const sources=(await e.DB.prepare('SELECT s.*,c.name AS course_name FROM study_sources s LEFT JOIN ntu_courses c ON c.id=s.course_id ORDER BY s.updated_at DESC LIMIT 51 OFFSET ?').bind(Math.floor(page)*50).all<Source&{course_name:string}>()).results ?? [];
const runs=(await e.DB.prepare("SELECT * FROM automation_runs ORDER BY started_at DESC LIMIT 10").all<Record<string,any>>()).results ?? [];
const jobs=(await e.DB.prepare('SELECT j.*,s.title FROM automation_jobs j JOIN study_sources s ON s.id=j.source_id ORDER BY j.updated_at DESC LIMIT 20').all<Record<string,any>>()).results ?? [];
const labels:Record<string,string>={completed:'已完成',running:'同步中',partial:'部分完成',needs_auth:'需要更新登录',failed:'失败',interrupted:'等待恢复',pending:'排队中',processing:'处理中',needs_ocr:'需要文字识别'};
---
<BaseLayout title="课程资料" brandHref="/">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <main class="study-shell">
    <nav><a href="/admin">← 管理中心</a><a class="button" href="/admin/ntu#settings">连接学校 / 选择课程</a></nav>
    <header><h1>课程资料 <span class="badge">私人</span></h1><p class="muted">集中保存课件、作业要求和公告，供你查看，也为后续 Muse 使用做准备。</p></header>
    <section class="panel"><strong>{c.enabled?'文件同步已开启':'文件同步已暂停'}</strong><p class="muted">{runs[0]?`最近检查：${singapore(runs[0].started_at)} · ${labels[runs[0].status]??runs[0].status}`:'尚未开始同步。先连接学校并选择课程，再开启下方的文件同步。'}</p>
      {runs[0]?.error&&<p class="error">{runs[0].error}</p>}
      <details open><summary>课程文件同步</summary>
        <form id="study-settings" data-revision={c.revision}>
          <label><input type="checkbox" name="enabled" checked={!!c.enabled} /> 自动同步课程文件</label>
          <label>检查频率<select name="intervalMinutes">{[30,60,120,360].map(n=><option value={n} selected={n===c.interval_minutes}>每 {n} 分钟</option>)}</select></label>
          <p class="muted">服务器会自动保存已选课程的新文件。首次导入只建立资料记录。</p>
          <button class="primary" type="submit">保存同步设置</button>
        </form>
      </details>
    </section>
    <section><h2>课程文件</h2>
      {!sources.length&&<p class="empty">还没有课程文件。连接学校并选择课程后，请在上方开启文件同步。</p>}
      {sources.slice(0,50).map(s=><article class="entry"><a href={`/admin/study/${s.id}`}><strong>{s.title}</strong></a><p class="muted">{s.course_name||s.course_id} · {s.kind==='assignment'?'Assignment':'课件'} · {s.version_id?'原件已保存':'等待下载或重试'} · {singapore(s.updated_at)}</p></article>)}
      <nav>{page>0&&<a href={`?page=${page-1}`}>上一页</a>}{sources.length>50&&<a href={`?page=${page+1}`}>下一页</a>}</nav>
    </section>
    {jobs.length>0&&<section class="panel"><h2>历史处理记录</h2>{jobs.map(j=><div class="entry"><a href={`/admin/study/${j.source_id}`}>{j.title}</a><p class="muted">{labels[j.status]??j.status}</p>{j.error&&<p class="error">{j.error}</p>}</div>)}</section>}
    <details class="panel"><summary>最近 10 次同步记录</summary>{runs.map(r=><div class="entry"><strong>{labels[r.status]??r.status} · {singapore(r.started_at)}</strong>{r.result&&<p class="muted">{r.result}</p>}{r.error&&<p class="error">{r.error}</p>}</div>)}</details>
    <div id="feedback" role="status" hidden></div>
  </main>
</BaseLayout>
<script>import '../../../scripts/study';</script>
