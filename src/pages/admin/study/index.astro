---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {env} from 'cloudflare:workers';
import {config,type StudyEnv,type Source} from '../../../server/study';
import {singapore} from '../../../server/ntu/core';
import '../../../styles/study.css';
if(!Astro.locals.adminSession)return Astro.redirect('/admin/login?next=%2Fadmin%2Fstudy');
const e=env as unknown as StudyEnv,c=await config(e);
const page=Math.max(0,Math.min(1000,Number(Astro.url.searchParams.get('page'))||0));
const sources=(await e.DB.prepare('SELECT s.*,c.name AS course_name FROM study_sources s LEFT JOIN ntu_courses c ON c.id=s.course_id ORDER BY s.updated_at DESC LIMIT 51 OFFSET ?').bind(Math.floor(page)*50).all<Source&{course_name:string}>()).results ?? [];
const runs=(await e.DB.prepare("SELECT * FROM automation_runs ORDER BY started_at DESC LIMIT 10").all<Record<string,any>>()).results ?? [];
const jobs=(await e.DB.prepare('SELECT j.*,s.title FROM automation_jobs j JOIN study_sources s ON s.id=j.source_id ORDER BY j.updated_at DESC LIMIT 20').all<Record<string,any>>()).results ?? [];
const labels:Record<string,string>={completed:'Completed',running:'Syncing',partial:'Partially completed',needs_auth:'Update login cookie',failed:'Failed',interrupted:'Waiting to resume',pending:'Queued',processing:'Processing',needs_ocr:'OCR needed'};
---
<BaseLayout title="NTU" brandHref="/">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <main class="study-shell">
    <nav><a href="/admin">← Admin</a><a class="button" href="/admin/ntu#settings">Connect NTULearn / Choose courses</a></nav>
    <header><h1>NTU <span class="badge">Private</span></h1><p class="muted">Your course files, assignments and announcements in one place, ready for future use by Muse.</p></header>
    <section class="panel"><strong>{c.enabled?'File sync enabled':'File sync paused'}</strong><p class="muted">{runs[0]?`Last checked: ${singapore(runs[0].started_at)} · ${labels[runs[0].status]??runs[0].status}`:'No sync runs yet. Connect NTULearn and choose courses, then enable file sync below.'}</p>
      {runs[0]?.error&&<p class="error">{runs[0].error}</p>}
      <details open><summary>Course file sync</summary>
        <form id="study-settings" data-revision={c.revision}>
          <label><input type="checkbox" name="enabled" checked={!!c.enabled} /> Automatically sync course files</label>
          <label>Check frequency<select name="intervalMinutes">{[30,60,120,360].map(n=><option value={n} selected={n===c.interval_minutes}>Every {n} minutes</option>)}</select></label>
          <p class="muted">The server saves new files from your selected courses. The first import builds your archive.</p>
          <button class="primary" type="submit">Save settings</button>
        </form>
      </details>
    </section>
    <section><h2>Course files</h2>
      {!sources.length&&<p class="empty">No files yet. Connect NTULearn, choose your courses and enable sync above.</p>}
      {sources.slice(0,50).map(s=><article class="entry"><a href={`/admin/study/${s.id}`}><strong>{s.title}</strong></a><p class="muted">{s.course_name||s.course_id} · {s.kind==='assignment'?'Assignment':'Material'} · {s.version_id?'File saved':'Waiting for download or retry'} · {singapore(s.updated_at)}</p></article>)}
      <nav>{page>0&&<a href={`?page=${page-1}`}>Previous</a>}{sources.length>50&&<a href={`?page=${page+1}`}>Next</a>}</nav>
    </section>
    {jobs.length>0&&<section class="panel"><h2>Processing history</h2>{jobs.map(j=><div class="entry"><a href={`/admin/study/${j.source_id}`}>{j.title}</a><p class="muted">{labels[j.status]??j.status}</p>{j.error&&<p class="error">{j.error}</p>}</div>)}</section>}
    <details class="panel"><summary>Last 10 sync runs</summary>{runs.map(r=><div class="entry"><strong>{labels[r.status]??r.status} · {singapore(r.started_at)}</strong>{r.result&&<p class="muted">{r.result}</p>}{r.error&&<p class="error">{r.error}</p>}</div>)}</details>
    <div id="feedback" role="status" hidden></div>
  </main>
</BaseLayout>
<script>import '../../../scripts/study';</script>
