---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {env} from 'cloudflare:workers';
import {type StudyEnv,type Source} from '../../../server/study';
import {studyMarkdown} from '../../../server/study-markdown';
import {singapore} from '../../../server/ntu/core';
import '../../../styles/study.css';
import 'katex/dist/katex.min.css';
if(!Astro.locals.adminSession)return Astro.redirect('/admin/login?next='+encodeURIComponent(Astro.url.pathname));
const e=env as unknown as StudyEnv;
const s=await e.DB.prepare('SELECT * FROM study_sources WHERE id=?').bind(Astro.params.id??'').first<Source>();
if(!s)return new Response('File not found',{status:404});
const versions=(await e.DB.prepare('SELECT * FROM study_versions WHERE source_id=? ORDER BY created_at DESC').bind(s.id).all<Record<string,any>>()).results ?? [];
const notes=(await e.DB.prepare('SELECT * FROM study_notes WHERE source_id=? ORDER BY created_at DESC').bind(s.id).all<Record<string,any>>()).results ?? [];
const current=notes.find(n=>n.version_id===s.version_id);
---
<BaseLayout title={s.title} bare brandHref="/admin">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <main class="study-shell"><nav><a href="/admin/study">← NTU</a><a href={s.source_url} target="_blank" rel="noopener noreferrer">View on NTULearn ↗</a></nav>
    <header><span class="badge">Private</span><h1>{s.title}</h1><p class="muted">{s.kind==='assignment'?'Assignment':'Course material'} · Updated {singapore(s.updated_at)}</p></header>
    {s.due_at&&<section class="panel"><strong>Due: {singapore(s.due_at)}</strong><p><a class="button" href={`/api/admin/study/calendar/${s.id}`}>Download calendar event</a></p><p class="muted">Download this event and import it into your calendar.</p></section>}
    <section class="panel"><h2>Original file</h2><div class="row">{s.version_id?<a class="button" href={`/api/admin/study/files/${s.version_id}`}>Download current version</a>:<p>File download is pending. Check the sync history for details.</p>}</div><p class="muted">Your original course file is stored here for future reading, revision or assignment work with Muse.</p>
      {s.body&&<details><summary>Course description</summary><p class="body">{s.body}</p></details>}
    </section>
    {current&&<article class="note" set:html={studyMarkdown(current.markdown)} />}
    <details class="panel"><summary>File versions & saved notes</summary>{versions.map(v=><div class="entry"><a href={`/api/admin/study/files/${v.id}`}>{v.filename}</a><p class="muted">{singapore(v.created_at)} · {(v.size/1024).toFixed(0)} KB · {v.id===s.version_id?'Current version':'Earlier version'}</p>{notes.filter(n=>n.version_id===v.id&&n.id!==current?.id).map(n=><details><summary>{n.model} · {singapore(n.created_at)} notes</summary><article class="note" set:html={studyMarkdown(n.markdown)} /></details>)}</div>)}</details>
    <div id="feedback" role="status" hidden></div>
  </main>
</BaseLayout>
<script>import '../../../scripts/study';</script>
