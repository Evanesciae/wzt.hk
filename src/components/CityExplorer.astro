---
import 'maplibre-gl/dist/maplibre-gl.css';
import type { CityDefinition } from '../data/cities';
import type { CityPlace } from '../server/types';

interface Props { cities: CityDefinition[]; places: CityPlace[] }
const { cities, places } = Astro.props;
const initialCity = cities[0];
const initialPlaces = places.filter((place) => place.city === initialCity.slug);
---

<section class="city-explorer" data-city-explorer data-cities={JSON.stringify(cities)} data-places={JSON.stringify(places)}>
  <div class="city-toolbar">
    <div class="city-switcher" role="tablist" aria-label="选择城市">
      {cities.map((city, index) => (
        <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} class:list={['city-switch-button', index === 0 && 'is-active']} data-city-slug={city.slug}>
          <span>{city.englishName}</span><strong>{city.name}</strong>
        </button>
      ))}
    </div>
    <label class="city-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="搜索地点、区域或标签…" data-city-search /></label>
  </div>

  <div class="city-filter-toolbar">
    <div class="city-filter-list" data-city-status-filters aria-label="按到访状态筛选">
      <button class="city-filter-button is-active" type="button" data-status="all">全部</button>
      <button class="city-filter-button" type="button" data-status="want">想去</button>
      <button class="city-filter-button" type="button" data-status="visited">去过</button>
      <button class="city-filter-button" type="button" data-status="favorite">收藏</button>
    </div>
    <div class="city-filter-list" data-city-type-filters aria-label="按类型筛选"></div>
  </div>

  <div class="city-map-frame" data-city-map-frame>
    <button class="map-fullscreen-button city-map-fullscreen" type="button" data-city-fullscreen>全屏地图</button>
    <div class="city-map-canvas" data-city-map aria-label="城市地点地图"></div>
    <div class="map-load-status" data-city-map-status hidden>地图暂时无法加载，仍可使用下方地点列表。</div>
  </div>

  <section class="city-place-section">
    <div class="section-heading">
      <div><p class="eyebrow">PLACES</p><h2 data-place-heading>{initialCity.name}</h2></div>
      <span class="city-list-count" data-visible-count>{initialPlaces.length} 个地点</span>
    </div>
    <div class="city-photo-list" data-city-photo-list></div>
    <div class="city-compact-list" data-city-compact-list></div>
    <p class="city-empty" data-city-empty hidden>没有找到匹配的地点。</p>
  </section>
</section>

<script>
  import { mediaUrl } from '../lib/media';

  interface Variant { width: number; height: number; path: string; size: number }
  interface Photo { id: string; featured: boolean; alt: string; variants: Variant[] }
  interface Place {
    id: string; city: string; name: string; type: string; district?: string; lat: number; lng: number;
    visitStatus: 'want' | 'visited'; favorite: boolean; recommendation?: string; address?: string;
    tags: string[]; rating?: number; photos: Photo[];
  }
  interface City { slug: string; name: string; englishName: string; center: [number, number]; zoom: number }

  const styleForTheme = (theme = document.documentElement.dataset.theme) =>
    `https://tiles.openfreemap.org/styles/${theme === 'dark' ? 'liberty' : 'positron'}`;
  const statusLabel = (place: Place) => place.visitStatus === 'visited' ? '去过' : '想去';
  const normalize = (value: string) => value.toLocaleLowerCase().normalize('NFKC');

  document.querySelectorAll<HTMLElement>('[data-city-explorer]').forEach(async (root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const cities: City[] = JSON.parse(root.dataset.cities ?? '[]');
    const places: Place[] = JSON.parse(root.dataset.places ?? '[]');
    const mapCanvas = root.querySelector<HTMLElement>('[data-city-map]');
    const mapFrame = root.querySelector<HTMLElement>('[data-city-map-frame]');
    const mapStatus = root.querySelector<HTMLElement>('[data-city-map-status]');
    const fullscreenButton = root.querySelector<HTMLButtonElement>('[data-city-fullscreen]');
    const typeFilters = root.querySelector<HTMLElement>('[data-city-type-filters]');
    const statusFilters = root.querySelector<HTMLElement>('[data-city-status-filters]');
    const search = root.querySelector<HTMLInputElement>('[data-city-search]');
    const photoList = root.querySelector<HTMLElement>('[data-city-photo-list]');
    const compactList = root.querySelector<HTMLElement>('[data-city-compact-list]');
    const empty = root.querySelector<HTMLElement>('[data-city-empty]');
    const placeHeading = root.querySelector<HTMLElement>('[data-place-heading]');
    const visibleCount = root.querySelector<HTMLElement>('[data-visible-count]');
    if (!mapCanvas || !mapFrame || !typeFilters || !statusFilters || !photoList || !compactList || cities.length === 0) return;
    const typeFilterList = typeFilters;
    const statusFilterList = statusFilters;
    const photoListElement = photoList;
    const compactListElement = compactList;

    const requestedCity = new URLSearchParams(window.location.search).get('city');
    let activeCity = cities.find((city) => city.slug === requestedCity) ?? cities[0];
    let activeType = 'all';
    let activeStatus = 'all';
    let query = '';
    let mapReady = false;
    const cityButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-city-slug]')];
    const { default: maplibregl } = await import('maplibre-gl');
    const map = new maplibregl.Map({ container: mapCanvas, style: styleForTheme(), center: activeCity.center, zoom: activeCity.zoom, cooperativeGestures: true });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    const cityPlaces = () => places.filter((place) => place.city === activeCity.slug);
    const visiblePlaces = () => cityPlaces().filter((place) => {
      const typeMatch = activeType === 'all' || place.type === activeType;
      const statusMatch = activeStatus === 'all' || (activeStatus === 'favorite' ? place.favorite : place.visitStatus === activeStatus);
      const haystack = normalize(`${place.name} ${place.type} ${place.district ?? ''} ${place.address ?? ''} ${place.tags.join(' ')}`);
      return typeMatch && statusMatch && (!query || haystack.includes(query));
    });
    const coverFor = (place: Place) => {
      const photo = place.photos.find((item) => item.featured) ?? place.photos[0];
      if (!photo) return;
      const variants = [...photo.variants].sort((a, b) => a.width - b.width);
      return { variant: variants[Math.min(1, variants.length - 1)], photoId: photo.id };
    };

    function metaLine(place: Place) {
      return [statusLabel(place), place.type, place.district].filter(Boolean).join(' · ');
    }
    function identity(place: Place) {
      const body = document.createElement('span'); body.className = 'city-photo-card-body';
      const copy = document.createElement('span');
      const title = document.createElement('strong'); title.textContent = `${place.favorite ? '★ ' : ''}${place.name}`;
      const meta = document.createElement('small'); meta.textContent = metaLine(place);
      copy.append(title, meta);
      if (place.recommendation) { const reason = document.createElement('p'); reason.textContent = place.recommendation; copy.append(reason); }
      const side = document.createElement('span'); side.className = 'city-card-side'; side.textContent = place.rating ? `${place.rating}/5` : '→';
      body.append(copy, side); return body;
    }
    function renderCards() {
      const current = visiblePlaces();
      photoListElement.innerHTML = ''; compactListElement.innerHTML = '';
      current.forEach((place) => {
        const link = document.createElement('a'); link.href = `/cities/${place.city}/${place.id}/`;
        const cover = coverFor(place);
        if (cover) {
          link.className = 'city-photo-card';
          const media = document.createElement('span'); media.className = 'city-place-cover';
          const image = document.createElement('img'); image.src = mediaUrl(cover.variant.path, cover.photoId); image.alt = ''; image.loading = 'lazy'; image.decoding = 'async';
          media.append(image); link.append(media, identity(place)); photoListElement.append(link);
        } else {
          link.className = 'city-compact-card'; link.append(identity(place)); compactListElement.append(link);
        }
      });
      if (photoListElement.children.length) photoListElement.setAttribute('aria-label', '有照片的地点');
      if (compactListElement.children.length) compactListElement.setAttribute('aria-label', '地点列表');
      if (empty) empty.hidden = current.length !== 0;
      if (placeHeading) placeHeading.textContent = activeCity.name;
      if (visibleCount) visibleCount.textContent = `${current.length} 个地点`;
    }
    function featureData() {
      return { type: 'FeatureCollection', features: visiblePlaces().map((place) => ({
        type: 'Feature', properties: { id: place.id }, geometry: { type: 'Point', coordinates: [place.lng, place.lat] },
      })) };
    }
    function popupContent(place: Place) {
      const content = document.createElement('div'); content.className = 'city-map-popup';
      const meta = document.createElement('span'); meta.textContent = metaLine(place);
      const name = document.createElement('strong'); name.textContent = place.name;
      const link = document.createElement('a'); link.href = `/cities/${place.city}/${place.id}/`; link.textContent = '查看地点 →';
      content.append(meta, name, link); return content;
    }
    function fitVisible(duration = 500) {
      const current = visiblePlaces();
      if (!current.length) { map.easeTo({ center: activeCity.center, zoom: activeCity.zoom, duration }); return; }
      if (current.length === 1) { map.easeTo({ center: [current[0].lng, current[0].lat], zoom: 13, duration }); return; }
      const bounds = new maplibregl.LngLatBounds(); current.forEach((place) => bounds.extend([place.lng, place.lat]));
      map.fitBounds(bounds, { padding: 72, maxZoom: 12.5, duration });
    }
    function setupMapLayers() {
      if (map.getSource('city-places')) return;
      map.addSource('city-places', { type: 'geojson', data: featureData() as any, cluster: true, clusterMaxZoom: 13, clusterRadius: 42 });
      map.addLayer({ id: 'city-clusters', type: 'circle', source: 'city-places', filter: ['has', 'point_count'], paint: { 'circle-color': '#3f6e63', 'circle-radius': ['step', ['get', 'point_count'], 18, 12, 23, 28, 29], 'circle-stroke-color': '#fff', 'circle-stroke-width': 2 } });
      map.addLayer({ id: 'city-cluster-count', type: 'symbol', source: 'city-places', filter: ['has', 'point_count'], layout: { 'text-field': ['get', 'point_count_abbreviated'], 'text-size': 11 }, paint: { 'text-color': '#fff' } });
      map.addLayer({ id: 'city-point', type: 'circle', source: 'city-places', filter: ['!', ['has', 'point_count']], paint: { 'circle-color': '#20201f', 'circle-radius': 7, 'circle-stroke-color': '#fff', 'circle-stroke-width': 2 } });
      mapReady = true; if (mapStatus) mapStatus.hidden = true; fitVisible(0);
    }
    map.on('style.load', setupMapLayers);
    map.on('error', () => { if (!mapReady && mapStatus) mapStatus.hidden = false; });
    map.on('click', 'city-clusters', async (event) => {
      const feature = map.queryRenderedFeatures(event.point, { layers: ['city-clusters'] })[0];
      const clusterId = feature?.properties?.cluster_id;
      const source = map.getSource('city-places') as any;
      if (clusterId == null || !source) return;
      const zoom = await source.getClusterExpansionZoom(clusterId);
      map.easeTo({ center: (feature.geometry as any).coordinates, zoom });
    });
    map.on('click', 'city-point', (event) => {
      const id = String(event.features?.[0]?.properties?.id ?? '');
      const place = places.find((item) => item.id === id); if (!place) return;
      new maplibregl.Popup({ offset: 12 }).setLngLat([place.lng, place.lat]).setDOMContent(popupContent(place)).addTo(map);
    });
    ['city-clusters', 'city-point'].forEach((layer) => {
      map.on('mouseenter', layer, () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', layer, () => { map.getCanvas().style.cursor = ''; });
    });
    setTimeout(() => { if (!mapReady && mapStatus) mapStatus.hidden = false; }, 7000);

    function updateMap() {
      if (!mapReady) return;
      const source = map.getSource('city-places') as any; source?.setData(featureData()); fitVisible();
    }
    function setStatus(status: string) {
      activeStatus = status;
      statusFilterList.querySelectorAll<HTMLButtonElement>('button').forEach((button) => button.classList.toggle('is-active', button.dataset.status === status));
      renderCards(); updateMap();
    }
    function setType(type: string) {
      activeType = type;
      typeFilterList.querySelectorAll<HTMLButtonElement>('button').forEach((button) => button.classList.toggle('is-active', button.dataset.type === type));
      renderCards(); updateMap();
    }
    function renderTypeFilters() {
      typeFilterList.innerHTML = '';
      ['all', ...new Set(cityPlaces().map((place) => place.type))].forEach((type) => {
        const button = document.createElement('button'); button.type = 'button'; button.dataset.type = type;
        button.className = `city-filter-button${type === activeType ? ' is-active' : ''}`; button.textContent = type === 'all' ? '全部类型' : type;
        button.addEventListener('click', () => setType(type)); typeFilterList.append(button);
      });
    }
    function renderCity() {
      cityButtons.forEach((button) => { const active = button.dataset.citySlug === activeCity.slug; button.classList.toggle('is-active', active); button.setAttribute('aria-selected', String(active)); });
      renderTypeFilters(); renderCards(); updateMap();
    }
    statusFilterList.querySelectorAll<HTMLButtonElement>('button').forEach((button) => button.addEventListener('click', () => setStatus(button.dataset.status ?? 'all')));
    search?.addEventListener('input', () => { query = normalize(search.value.trim()); renderCards(); updateMap(); });
    cityButtons.forEach((button) => button.addEventListener('click', () => {
      const next = cities.find((city) => city.slug === button.dataset.citySlug); if (!next || next.slug === activeCity.slug) return;
      activeCity = next; activeType = 'all'; activeStatus = 'all'; query = ''; if (search) search.value = '';
      const url = new URL(window.location.href); url.searchParams.set('city', activeCity.slug); history.replaceState({}, '', url); renderCity();
    }));
    fullscreenButton?.addEventListener('click', async () => { if (document.fullscreenElement === mapFrame) await document.exitFullscreen(); else await mapFrame.requestFullscreen(); });
    document.addEventListener('fullscreenchange', () => { if (fullscreenButton) fullscreenButton.textContent = document.fullscreenElement === mapFrame ? '退出全屏' : '全屏地图'; map.resize(); });
    document.addEventListener('site-theme-change', ((event: CustomEvent<string>) => { mapReady = false; map.setStyle(styleForTheme(event.detail)); }) as EventListener);
    renderCity();
  });
</script>
