---
import type { TravelEvent } from '../server/types';
import { mediaUrl } from '../lib/media';

interface Props {
  event: TravelEvent;
  order: number;
}

const { event, order } = Astro.props;
const typeMeta = {
  place: { label: '地点', symbol: '○' },
  transit: { label: '交通', symbol: '→' },
  meal: { label: '餐饮', symbol: '◇' },
  stay: { label: '住宿', symbol: '□' },
  note: { label: '记录', symbol: '—' },
} as const;
const methodLabels = {
  flight: '飞机', train: '火车', metro: '地铁', bus: '巴士', ferry: '渡轮',
  car: '驾车', walk: '步行', other: '其他',
} as const;
const mealLabels = {
  breakfast: '早餐', lunch: '午餐', dinner: '晚餐', cafe: '咖啡', snack: '小吃', other: '餐饮',
} as const;
const preparedPhotos = event.photos.map((photo) => {
  const variants = [...photo.variants].sort((a, b) => a.width - b.width);
  return { ...photo, thumb: variants[0], full: variants.at(-1), variants };
});
const photoItems = preparedPhotos.map((photo) => ({
  src: photo.full ? mediaUrl(photo.full.path, photo.id) : '',
  alt: photo.alt,
  caption: photo.caption ?? event.title,
}));
---

<article class:list={['timeline-event', `event-${event.type}`, event.location && 'event-has-map']} id={`event-${event.id}`}>
  <div class="event-marker" aria-hidden="true">
    <span>{order}</span>
  </div>
  <div class="event-body">
    <div class="event-kicker">
      <span>{typeMeta[event.type].symbol} {typeMeta[event.type].label}</span>
      {event.time && <time>{event.time}</time>}
    </div>
    <h3>{event.title}</h3>

    {event.type === 'transit' && (
      <div class="event-details">
        {event.data.method && <span>{methodLabels[event.data.method as keyof typeof methodLabels] ?? event.data.method}</span>}
        {event.data.from && event.data.to && <span>{event.data.from} → {event.data.to}</span>}
        {event.data.number && <span>{event.data.number}</span>}
      </div>
    )}
    {event.type === 'meal' && (
      <div class="event-details">
        {event.data.mealType && <span>{mealLabels[event.data.mealType as keyof typeof mealLabels] ?? event.data.mealType}</span>}
        {event.data.cost && <span>{event.data.cost}</span>}
        {typeof event.data.rating === 'number' && <span>{event.data.rating}/5</span>}
      </div>
    )}
    {event.type === 'meal' && (event.data.dishes?.length ?? 0) > 0 && (
      <p class="dish-list">{event.data.dishes?.join(' · ')}</p>
    )}
    {event.location?.address && <p class="event-address">{event.location.address}</p>}
    {event.location && <button class="event-map-link" type="button" data-event-map data-day-id={event.dayId} data-lat={event.location.lat} data-lng={event.location.lng} data-title={event.title}>地图定位 ↗</button>}
    {event.note && <p class="event-note">{event.note}</p>}
    {event.type === 'stay' && event.data.booking && (
      <a class="text-link" href={event.data.booking} target="_blank" rel="noreferrer">查看预订 ↗</a>
    )}

    {preparedPhotos.length > 0 && (
      <div class="event-photo-album" data-photo-gallery data-photo-items={JSON.stringify(photoItems)}>
        <div class="event-photos" aria-label={`${event.title}照片预览`}>
          {preparedPhotos.map((photo, index) => {
            const previewSrc = photo.thumb ? mediaUrl(photo.thumb.path, photo.id) : '';
            const previewSrcset = photo.variants.map((variant) => `${mediaUrl(variant.path, photo.id)} ${variant.width}w`).join(', ');
            return <button
              type="button"
              data-photo-index={index}
              data-event-photo-extra={index >= 4 ? '' : undefined}
              hidden={index >= 4}
              aria-label={`查看照片：${photo.alt}`}
            >
              {photo.thumb && <img
                src={index === 0 ? previewSrc : undefined}
                srcset={index === 0 ? previewSrcset : undefined}
                data-src={index === 0 ? undefined : previewSrc}
                data-srcset={index === 0 ? undefined : previewSrcset}
                sizes="160px"
                width={photo.thumb.width}
                height={photo.thumb.height}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />}
            </button>;
          })}
        </div>
        {preparedPhotos.length > 4 && (
          <button
            class="event-photo-expand"
            type="button"
            data-event-photo-expand
            data-collapsed-label={`展开其余 ${preparedPhotos.length - 4} 张`}
            aria-expanded="false"
          >展开其余 {preparedPhotos.length - 4} 张</button>
        )}
        <dialog class="photo-dialog" data-photo-dialog>
          <button type="button" class="dialog-close" data-dialog-close aria-label="关闭照片">×</button>
          <div class="photo-dialog-stage">
            <button type="button" class="photo-dialog-nav photo-dialog-previous" data-dialog-previous aria-label="上一张照片"><span aria-hidden="true">‹</span></button>
            <img data-dialog-image alt="" />
            <button type="button" class="photo-dialog-nav photo-dialog-next" data-dialog-next aria-label="下一张照片"><span aria-hidden="true">›</span></button>
          </div>
          <footer class="photo-dialog-meta"><p data-dialog-caption></p><span data-dialog-counter></span></footer>
        </dialog>
      </div>
    )}
  </div>
</article>

<script>
  import { setupPhotoLightboxes } from '../lib/photo-lightbox';
  setupPhotoLightboxes();
  const hydratePhoto = (image: HTMLImageElement) => {
    if (image.dataset.srcset) image.srcset = image.dataset.srcset;
    if (image.dataset.src) image.src = image.dataset.src;
    delete image.dataset.srcset;
    delete image.dataset.src;
  };
  const hydrateVisiblePhotos = (album: HTMLElement) => {
    album.querySelectorAll<HTMLImageElement>('button:not([hidden]) img[data-src]').forEach(hydratePhoto);
  };
  const photoObserver = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      hydrateVisiblePhotos(entry.target as HTMLElement);
      observer.unobserve(entry.target);
    }), { rootMargin: '600px 0px' })
    : null;
  document.querySelectorAll<HTMLElement>('[data-photo-gallery]:not([data-lazy-ready])').forEach((album) => {
    album.dataset.lazyReady = 'true';
    if (photoObserver) photoObserver.observe(album);
    else hydrateVisiblePhotos(album);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-event-photo-expand]:not([data-ready])').forEach((button) => {
    button.dataset.ready = 'true';
    button.addEventListener('click', () => {
      const album = button.closest<HTMLElement>('[data-photo-gallery]');
      if (!album) return;
      const expanded = button.getAttribute('aria-expanded') === 'true';
      album.querySelectorAll<HTMLElement>('[data-event-photo-extra]').forEach((photo) => { photo.hidden = expanded; });
      if (!expanded) hydrateVisiblePhotos(album);
      button.setAttribute('aria-expanded', String(!expanded));
      button.textContent = expanded ? (button.dataset.collapsedLabel ?? '展开全部') : '收起照片';
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-event-map]:not([data-ready])').forEach((button) => {
    button.dataset.ready = 'true';
    button.addEventListener('click', () => document.dispatchEvent(new CustomEvent('travel-map-focus', { detail: {
      dayId: button.dataset.dayId, lat: Number(button.dataset.lat), lng: Number(button.dataset.lng), title: button.dataset.title,
    } })));
  });
</script>
