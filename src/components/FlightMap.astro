---
import 'maplibre-gl/dist/maplibre-gl.css';
import type { SurfaceRoute } from '../data/travel-routes';
import type { Flight } from '../server/types';

interface Props {
  flights: Flight[];
  surfaceRoutes?: SurfaceRoute[];
  compact?: boolean;
}

const { flights, surfaceRoutes = [], compact = false } = Astro.props;
const routes = flights.map((flight) => ({
  from: { code: flight.fromAirport.code, city: flight.fromAirport.city, lat: flight.fromAirport.lat, lng: flight.fromAirport.lng },
  to: { code: flight.toAirport.code, city: flight.toAirport.city, lat: flight.toAirport.lat, lng: flight.toAirport.lng },
})).filter((route) => Number.isFinite(route.from.lat) && Number.isFinite(route.from.lng)
  && Number.isFinite(route.to.lat) && Number.isFinite(route.to.lng));
const hasJourneys = routes.length > 0 || surfaceRoutes.length > 0;
---

<div class:list={['flight-map-frame', compact && 'flight-map-compact']} data-flight-map data-compact={compact ? 'true' : 'false'} data-routes={JSON.stringify(routes)} data-surface-routes={JSON.stringify(surfaceRoutes)}>
  <div class="flight-map-actions">
    <button class="map-fullscreen-button" type="button" data-flight-map-fullscreen aria-label="全屏查看旅行足迹">全屏</button>
    <button class="map-fullscreen-button" type="button" data-flight-map-home aria-label="缩小至地球视图">地球</button>
  </div>
  <div class="map-canvas flight-globe-canvas" data-flight-map-canvas aria-label="可旋转的球形旅行足迹地图"></div>
  {hasJourneys && <div class="journey-map-legend" aria-label="路线图例">
    {routes.length > 0 && <span><i class="is-flight"></i>飞机</span>}
    {surfaceRoutes.some((route) => route.mode === 'rail') && <span><i class="is-rail"></i>铁路</span>}
    {surfaceRoutes.some((route) => route.mode === 'drive') && <span><i class="is-drive"></i>自驾</span>}
  </div>}
  {hasJourneys && <div class="flight-map-hud" aria-hidden="true"><span></span>FOOTPRINT</div>}
  {!hasJourneys && <div class="map-empty">还没有可绘制的旅行足迹。</div>}
  {hasJourneys && <div class="map-load-status" data-map-load-status hidden>地图暂时无法加载，足迹列表仍可正常浏览。</div>}
</div>

<script>
  import type { CustomLayerInterface, CustomRenderMethodInput } from 'maplibre-gl';

  interface RoutePoint { code: string; city: string; lat: number; lng: number }
  interface Route { from: RoutePoint; to: RoutePoint }
  interface RouteGroup { key: string; pairKey: string; from: RoutePoint; to: RoutePoint; count: number }
  interface SurfaceStop { name: string; lat: number; lng: number }
  interface SurfaceJourney { id: string; mode: 'rail' | 'drive'; title: string; stops: SurfaceStop[]; coordinates: [number, number][] }
  interface GeoPoint { lat: number; lng: number }

  type Vector3 = [number, number, number];
  type ArcPoint = [number, number, number];
  interface ArcLane { points: ArcPoint[]; offset: number }

  function toVector(point: GeoPoint): Vector3 {
    const latitude = point.lat * Math.PI / 180;
    const longitude = point.lng * Math.PI / 180;
    const radius = Math.cos(latitude);
    return [radius * Math.cos(longitude), radius * Math.sin(longitude), Math.sin(latitude)];
  }

  function normalize(vector: Vector3): Vector3 {
    const magnitude = Math.hypot(...vector);
    return magnitude < 1e-8 ? [0, 0, 0] : vector.map((value) => value / magnitude) as Vector3;
  }

  function cross(a: Vector3, b: Vector3): Vector3 {
    return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
  }

  function elevatedArc(from: RoutePoint, to: RoutePoint, direction: number, altitudeScale = 1): ArcPoint[] {
    const start = toVector(from);
    const end = toVector(to);
    const dot = Math.min(1, Math.max(-1, start[0] * end[0] + start[1] * end[1] + start[2] * end[2]));
    const angle = Math.acos(dot);
    const denominator = Math.sin(angle);
    const normal = normalize(cross(start, end));
    const lateralBend = direction * Math.min(Math.max(angle * .035, .0035), .014);
    const peakAltitude = Math.min(Math.max(angle * 6_371_008.8 * .23, 120_000), 850_000);
    const steps = Math.max(56, Math.ceil(angle * 72));
    const coordinates: ArcPoint[] = [];
    let previousLongitude = from.lng;

    for (let index = 0; index <= steps; index += 1) {
      const t = index / steps;
      const startWeight = denominator < 1e-6 ? 1 - t : Math.sin((1 - t) * angle) / denominator;
      const endWeight = denominator < 1e-6 ? t : Math.sin(t * angle) / denominator;
      const base = normalize([
        startWeight * start[0] + endWeight * end[0],
        startWeight * start[1] + endWeight * end[1],
        startWeight * start[2] + endWeight * end[2],
      ]);
      const offset = Math.sin(Math.PI * t) * lateralBend;
      const [x, y, z] = normalize([
        base[0] * Math.cos(offset) + normal[0] * Math.sin(offset),
        base[1] * Math.cos(offset) + normal[1] * Math.sin(offset),
        base[2] * Math.cos(offset) + normal[2] * Math.sin(offset),
      ]);
      let longitude = Math.atan2(y, x) * 180 / Math.PI;
      const latitude = Math.atan2(z, Math.sqrt(x * x + y * y)) * 180 / Math.PI;
      const altitude = Math.pow(Math.sin(Math.PI * t), .82) * peakAltitude * altitudeScale;

      while (longitude - previousLongitude > 180) longitude -= 360;
      while (longitude - previousLongitude < -180) longitude += 360;
      coordinates.push([longitude, latitude, altitude]);
      previousLongitude = longitude;
    }
    return coordinates;
  }

  function groupRoutes(routes: Route[]): RouteGroup[] {
    const groups = new Map<string, RouteGroup>();
    routes.forEach((route) => {
      const ordered = route.from.code.localeCompare(route.to.code) <= 0
        ? [route.from, route.to]
        : [route.to, route.from];
      const pairKey = `${ordered[0].code}-${ordered[1].code}`;
      const key = `${route.from.code}-${route.to.code}`;
      const existing = groups.get(key);
      if (existing) existing.count += 1;
      else groups.set(key, { key, pairKey, from: route.from, to: route.to, count: 1 });
    });
    return [...groups.values()];
  }

  function curveDirection(key: string) {
    return [...key].reduce((hash, character) => hash + character.charCodeAt(0), 0) % 2 === 0 ? 1 : -1;
  }

  function bundleOffsets(count: number) {
    if (count >= 8) return [-4.2, 0, 4.2];
    if (count >= 4) return [-2.8, 2.8];
    return [0];
  }

  function toMercator([longitude, latitude, altitude]: ArcPoint): [number, number, number] {
    const limitedLatitude = Math.max(-85.051129, Math.min(85.051129, latitude));
    const radians = limitedLatitude * Math.PI / 180;
    return [
      (longitude + 180) / 360,
      (1 - Math.log(Math.tan(radians) + 1 / Math.cos(radians)) / Math.PI) / 2,
      altitude,
    ];
  }

  function arcVertices(arcs: ArcLane[]): Float32Array {
    const vertices: number[] = [];
    const addVertex = (arc: ArcLane, index: number, side: number) => {
      const point = arc.points[index];
      const previous = arc.points[Math.max(0, index - 1)];
      const next = arc.points[Math.min(arc.points.length - 1, index + 1)];
      const lane = arc.offset * Math.sin(Math.PI * index / (arc.points.length - 1));
      vertices.push(...toMercator(point), ...toMercator(previous), ...toMercator(next), side, lane);
    };
    arcs.forEach((arc) => {
      for (let index = 0; index < arc.points.length - 1; index += 1) {
        addVertex(arc, index, -1);
        addVertex(arc, index, 1);
        addVertex(arc, index + 1, -1);
        addVertex(arc, index + 1, -1);
        addVertex(arc, index, 1);
        addVertex(arc, index + 1, 1);
      }
    });
    return new Float32Array(vertices);
  }

  function createArcLayer(arcs: ArcLane[], dark: boolean): CustomLayerInterface {
    const vertexData = arcVertices(arcs);
    let buffer: WebGLBuffer | null = null;
    let program: WebGLProgram | null = null;
    let shaderVariant = '';

    const compileShader = (gl: WebGL2RenderingContext, type: number, source: string) => {
      const shader = gl.createShader(type);
      if (!shader) throw new Error('Unable to create flight arc shader.');
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        const message = gl.getShaderInfoLog(shader) ?? 'Unknown shader error';
        gl.deleteShader(shader);
        throw new Error(message);
      }
      return shader;
    };

    const buildProgram = (gl: WebGL2RenderingContext, input: CustomRenderMethodInput) => {
      if (program) gl.deleteProgram(program);
      const vertexShader = compileShader(gl, gl.VERTEX_SHADER, `#version 300 es
        precision highp float;
        ${input.shaderData.vertexShaderPrelude}
        ${input.shaderData.define}
        in vec3 a_position;
        in vec3 a_previous;
        in vec3 a_next;
        in float a_side;
        in float a_lane;
        uniform vec2 u_viewport;
        uniform float u_width;
        uniform float u_pixel_ratio;
        void main() {
          vec4 current = projectTileFor3D(a_position.xy, a_position.z);
          vec4 previous = projectTileFor3D(a_previous.xy, a_previous.z);
          vec4 next = projectTileFor3D(a_next.xy, a_next.z);
          vec2 currentScreen = current.xy / current.w;
          vec2 incomingDelta = (currentScreen - previous.xy / previous.w) * u_viewport;
          vec2 outgoingDelta = (next.xy / next.w - currentScreen) * u_viewport;
          float incomingLength = length(incomingDelta);
          float outgoingLength = length(outgoingDelta);
          vec2 incoming = incomingLength > 0.001 ? incomingDelta / incomingLength : outgoingDelta / max(outgoingLength, 0.001);
          vec2 outgoing = outgoingLength > 0.001 ? outgoingDelta / outgoingLength : incoming;
          vec2 tangentSum = incoming + outgoing;
          vec2 tangent = length(tangentSum) > 0.001 ? normalize(tangentSum) : outgoing;
          vec2 miter = vec2(-tangent.y, tangent.x);
          vec2 outgoingNormal = vec2(-outgoing.y, outgoing.x);
          float miterScale = min(2.4, 1.0 / max(abs(dot(miter, outgoingNormal)), 0.01));
          float offset = (a_side * u_width + a_lane) * u_pixel_ratio * miterScale;
          current.xy += miter * offset * 2.0 / u_viewport * current.w;
          gl_Position = current;
        }
      `);
      const fragmentShader = compileShader(gl, gl.FRAGMENT_SHADER, `#version 300 es
        precision mediump float;
        uniform vec4 u_color;
        out vec4 fragColor;
        void main() { fragColor = u_color; }
      `);
      const nextProgram = gl.createProgram();
      if (!nextProgram) throw new Error('Unable to create flight arc program.');
      gl.attachShader(nextProgram, vertexShader);
      gl.attachShader(nextProgram, fragmentShader);
      gl.linkProgram(nextProgram);
      gl.deleteShader(vertexShader);
      gl.deleteShader(fragmentShader);
      if (!gl.getProgramParameter(nextProgram, gl.LINK_STATUS)) {
        const message = gl.getProgramInfoLog(nextProgram) ?? 'Unknown program error';
        gl.deleteProgram(nextProgram);
        throw new Error(message);
      }
      program = nextProgram;
      shaderVariant = input.shaderData.variantName;
    };

    return {
      id: 'flight-arcs-3d',
      type: 'custom',
      renderingMode: '3d',
      onAdd(_map, rawGl) {
        const gl = rawGl as WebGL2RenderingContext;
        buffer = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
        gl.bufferData(gl.ARRAY_BUFFER, vertexData, gl.STATIC_DRAW);
      },
      render(rawGl, input) {
        const gl = rawGl as WebGL2RenderingContext;
        if (!buffer || vertexData.length === 0) return;
        if (!program || shaderVariant !== input.shaderData.variantName) buildProgram(gl, input);
        if (!program) return;

        gl.useProgram(program);
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
        const stride = 11 * Float32Array.BYTES_PER_ELEMENT;
        const positionLocation = gl.getAttribLocation(program, 'a_position');
        const previousLocation = gl.getAttribLocation(program, 'a_previous');
        const nextLocation = gl.getAttribLocation(program, 'a_next');
        const sideLocation = gl.getAttribLocation(program, 'a_side');
        const laneLocation = gl.getAttribLocation(program, 'a_lane');
        gl.enableVertexAttribArray(positionLocation);
        gl.enableVertexAttribArray(previousLocation);
        gl.enableVertexAttribArray(nextLocation);
        gl.enableVertexAttribArray(sideLocation);
        gl.enableVertexAttribArray(laneLocation);
        gl.vertexAttribPointer(positionLocation, 3, gl.FLOAT, false, stride, 0);
        gl.vertexAttribPointer(previousLocation, 3, gl.FLOAT, false, stride, 3 * Float32Array.BYTES_PER_ELEMENT);
        gl.vertexAttribPointer(nextLocation, 3, gl.FLOAT, false, stride, 6 * Float32Array.BYTES_PER_ELEMENT);
        gl.vertexAttribPointer(sideLocation, 1, gl.FLOAT, false, stride, 9 * Float32Array.BYTES_PER_ELEMENT);
        gl.vertexAttribPointer(laneLocation, 1, gl.FLOAT, false, stride, 10 * Float32Array.BYTES_PER_ELEMENT);

        const projection = input.defaultProjectionData;
        gl.uniformMatrix4fv(gl.getUniformLocation(program, 'u_projection_matrix'), false, projection.mainMatrix);
        gl.uniform4fv(gl.getUniformLocation(program, 'u_projection_tile_mercator_coords'), projection.tileMercatorCoords);
        gl.uniform4fv(gl.getUniformLocation(program, 'u_projection_clipping_plane'), projection.clippingPlane);
        gl.uniform1f(gl.getUniformLocation(program, 'u_projection_transition'), projection.projectionTransition);
        gl.uniformMatrix4fv(gl.getUniformLocation(program, 'u_projection_fallback_matrix'), false, projection.fallbackMatrix);
        gl.uniform2f(gl.getUniformLocation(program, 'u_viewport'), gl.drawingBufferWidth, gl.drawingBufferHeight);
        gl.uniform1f(gl.getUniformLocation(program, 'u_pixel_ratio'), window.devicePixelRatio || 1);

        gl.enable(gl.BLEND);
        gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
        gl.depthMask(false);
        const draw = (width: number, color: [number, number, number, number]) => {
          gl.uniform1f(gl.getUniformLocation(program!, 'u_width'), width);
          gl.uniform4fv(gl.getUniformLocation(program!, 'u_color'), color);
          gl.drawArrays(gl.TRIANGLES, 0, vertexData.length / 11);
        };
        draw(3, dark ? [.28, .68, .92, .13] : [.05, .39, .64, .11]);
        draw(.95, dark ? [.48, .8, .97, .94] : [.04, .36, .61, .9]);
        gl.depthMask(true);
      },
      onRemove(_map, rawGl) {
        const gl = rawGl as WebGL2RenderingContext;
        if (buffer) gl.deleteBuffer(buffer);
        if (program) gl.deleteProgram(program);
        buffer = null;
        program = null;
      },
    };
  }

  function centerOf(points: GeoPoint[]): [number, number] {
    const vector = points.reduce<Vector3>((total, point) => {
      const next = toVector(point);
      return [total[0] + next[0], total[1] + next[1], total[2] + next[2]];
    }, [0, 0, 0]);
    const magnitude = Math.hypot(...vector);
    if (magnitude < 1e-6) return [points[0]?.lng ?? 0, points[0]?.lat ?? 20];
    const [x, y, z] = vector.map((value) => value / magnitude) as Vector3;
    return [Math.atan2(y, x) * 180 / Math.PI, Math.atan2(z, Math.sqrt(x * x + y * y)) * 180 / Math.PI];
  }

  document.querySelectorAll<HTMLElement>('[data-flight-map]').forEach(async (root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const routes: Route[] = JSON.parse(root.dataset.routes ?? '[]');
    const surfaceRoutes: SurfaceJourney[] = JSON.parse(root.dataset.surfaceRoutes ?? '[]');
    const canvas = root.querySelector<HTMLElement>('[data-flight-map-canvas]');
    const fullscreenButton = root.querySelector<HTMLButtonElement>('[data-flight-map-fullscreen]');
    const homeButton = root.querySelector<HTMLButtonElement>('[data-flight-map-home]');
    if (!canvas || (routes.length === 0 && surfaceRoutes.length === 0)) return;
    const { default: maplibregl } = await import('maplibre-gl');
    let dark = document.documentElement.dataset.theme === 'dark';
    const loadStatus = root.querySelector<HTMLElement>('[data-map-load-status]');
    let loaded = false;
    const compact = root.dataset.compact === 'true';
    const airports = routes.flatMap((route) => [route.from, route.to]);
    const surfacePoints = surfaceRoutes.flatMap((route) => route.stops.length > 0
      ? route.stops
      : route.coordinates.map(([lng, lat]) => ({ lat, lng })));
    const overviewCenter = centerOf([...airports, ...surfacePoints]);
    const overviewZoomForWidth = () => compact
      ? 1.65
      : Math.min(2.35, .72 + Math.max(0, Math.log2(canvas.clientWidth / 420)) * 1.05);
    const overviewZoom = overviewZoomForWidth();
    const map = new maplibregl.Map({
      container: canvas,
      style: `https://tiles.openfreemap.org/styles/${dark ? 'dark' : 'positron'}`,
      center: overviewCenter,
      zoom: overviewZoomForWidth(),
      pitch: 12,
      cooperativeGestures: true,
      renderWorldCopies: false,
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: true, visualizePitch: true }), 'top-right');

    const showGlobe = () => map.easeTo({
      center: overviewCenter,
      zoom: overviewZoom,
      bearing: 0,
      pitch: 12,
      duration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 900,
    });
    homeButton?.addEventListener('click', showGlobe);
    fullscreenButton?.addEventListener('click', async () => {
      if (document.fullscreenElement === root) {
        await document.exitFullscreen();
      } else {
        await root.requestFullscreen();
      }
      setTimeout(() => map.resize(), 80);
    });
    document.addEventListener('fullscreenchange', () => {
      fullscreenButton && (fullscreenButton.textContent = document.fullscreenElement === root ? '退出全屏' : '全屏');
      map.resize();
    });

    const groupedRoutes = groupRoutes(routes);
    const routeArcs = groupedRoutes.map((route) => elevatedArc(route.from, route.to, curveDirection(route.pairKey)));
    const visualArcs = groupedRoutes.flatMap((route) => {
      const offsets = bundleOffsets(route.count);
      return offsets.map((offset) => ({
        points: elevatedArc(route.from, route.to, curveDirection(route.pairKey), 1 + offset * .018),
        offset,
      }));
    });
    const routeFeatures = groupedRoutes.map((route, index) => ({
      type: 'Feature' as const,
      properties: { count: route.count, title: `${route.from.code} → ${route.to.code} · ${route.count} 次航班` },
      geometry: { type: 'LineString' as const, coordinates: routeArcs[index].map(([lng, lat]) => [lng, lat]) },
    }));
    const airportMap = new Map<string, RoutePoint>();
    const airportVisits = new Map<string, number>();
    routes.forEach((route) => {
      airportMap.set(route.from.code, route.from);
      airportMap.set(route.to.code, route.to);
      airportVisits.set(route.from.code, (airportVisits.get(route.from.code) ?? 0) + 1);
      airportVisits.set(route.to.code, (airportVisits.get(route.to.code) ?? 0) + 1);
    });
    const airportFeatures = [...airportMap.values()].map((airport) => ({
      type: 'Feature' as const,
      properties: { code: airport.code, visits: airportVisits.get(airport.code) ?? 1, title: `${airport.city} ${airport.code}` },
      geometry: { type: 'Point' as const, coordinates: [airport.lng, airport.lat] as [number, number] },
    }));
    const surfaceFeatures = surfaceRoutes.map((route) => ({
      type: 'Feature' as const,
      properties: {
        id: route.id,
        mode: route.mode,
        title: route.title,
        caption: route.mode === 'rail' ? '铁路' : '自驾',
      },
      geometry: { type: 'LineString' as const, coordinates: route.coordinates },
    }));
    const surfaceStopMap = new Map<string, SurfaceStop>();
    surfaceRoutes
      .filter((route) => route.mode === 'rail')
      .forEach((route) => route.stops.forEach((stop) => surfaceStopMap.set(stop.name, stop)));
    const surfaceStopFeatures = [...surfaceStopMap.values()].map((stop) => ({
      type: 'Feature' as const,
      properties: { title: stop.name },
      geometry: { type: 'Point' as const, coordinates: [stop.lng, stop.lat] as [number, number] },
    }));

    let interactionsBound = false;
    let initialViewApplied = false;
    map.on('style.load', () => {
      loaded = true;
      if (loadStatus) loadStatus.hidden = true;
      map.setProjection({ type: 'globe' });
      const palette = dark
        ? { land: '#15212a', ocean: '#07131c', boundary: '#31414b' }
        : { land: '#f2f0ea', ocean: '#d7e3e8', boundary: '#b6c1c5' };
      map.getStyle().layers?.forEach((layer) => {
        const sourceLayer = 'source-layer' in layer ? String(layer['source-layer'] ?? '') : '';
        const layerName = `${layer.id} ${sourceLayer}`.toLowerCase();
        if (layer.type === 'symbol') {
          const isPlaceLabel = sourceLayer.toLowerCase() === 'place' || /(^|[-_ ])place([-_ ]|$)/.test(layerName);
          const isWaterLabel = sourceLayer.toLowerCase() === 'water_name'
            || /(ocean|sea|marine|water)[-_ ]?(name|label)/.test(layerName);
          if (!isPlaceLabel && !isWaterLabel) {
            map.setLayoutProperty(layer.id, 'visibility', 'none');
            return;
          }
          const isCountry = /country/.test(layerName);
          const isRegion = /(state|province)/.test(layerName);
          const isLocalPlace = /(town|village|hamlet|suburb|neighbourhood)/.test(layerName);
          const opacity = isCountry ? .72 : isRegion ? .52 : isLocalPlace ? .42 : isWaterLabel ? .38 : .6;
          map.setLayoutProperty(layer.id, 'visibility', 'visible');
          map.setPaintProperty(layer.id, 'text-color', isWaterLabel
            ? (dark ? '#7994a3' : '#758b94')
            : (dark ? '#aebcc4' : '#59666c'));
          map.setPaintProperty(layer.id, 'text-opacity', dark ? Math.min(opacity + .06, .78) : opacity);
          map.setPaintProperty(layer.id, 'text-halo-color', dark ? '#07131c' : '#f2f0ea');
          map.setPaintProperty(layer.id, 'text-halo-width', 1.15);
          return;
        }
        if (layer.type === 'circle' || layer.type === 'fill-extrusion'
          || layer.type === 'heatmap' || layer.type === 'hillshade' || layer.type === 'raster') {
          map.setLayoutProperty(layer.id, 'visibility', 'none');
          return;
        }
        if (layer.type === 'background') {
          map.setPaintProperty(layer.id, 'background-color', palette.land);
          return;
        }
        if (layer.type === 'fill') {
          if (layerName.includes('water')) {
            map.setPaintProperty(layer.id, 'fill-color', palette.ocean);
            map.setPaintProperty(layer.id, 'fill-opacity', 1);
          } else if (/earth|landmass/.test(layerName)) {
            map.setPaintProperty(layer.id, 'fill-color', palette.land);
            map.setPaintProperty(layer.id, 'fill-opacity', 1);
          } else {
            map.setLayoutProperty(layer.id, 'visibility', 'none');
          }
          return;
        }
        if (layer.type === 'line') {
          const isCountryBoundary = layerName.includes('boundary')
            && /(country|admin[_-]?0|boundary[_-]?2)/.test(layerName);
          if (isCountryBoundary) {
            map.setPaintProperty(layer.id, 'line-color', palette.boundary);
            map.setPaintProperty(layer.id, 'line-opacity', dark ? .5 : .58);
            map.setPaintProperty(layer.id, 'line-width', .65);
          } else {
            map.setLayoutProperty(layer.id, 'visibility', 'none');
          }
        }
      });
      map.setSky({
        'sky-color': dark ? '#030910' : '#dbe7ec',
        'horizon-color': dark ? '#101b24' : '#f6f8f7',
        'fog-color': dark ? '#071018' : '#e9f0f1',
        'sky-horizon-blend': .78,
        'horizon-fog-blend': .82,
        'fog-ground-blend': .42,
        'atmosphere-blend': ['interpolate', ['linear'], ['zoom'], 0, 1, 5, 1, 7, 0],
      });
      map.setLight({
        anchor: 'viewport',
        color: dark ? '#a5c4d4' : '#ffffff',
        intensity: dark ? .28 : .7,
        position: [1.5, 90, 18],
      });
      if (!initialViewApplied) {
        initialViewApplied = true;
        map.jumpTo({ center: overviewCenter, zoom: overviewZoom, bearing: 0, pitch: 12 });
      }
      if (routeFeatures.length > 0) {
        map.addSource('flight-routes', { type: 'geojson', lineMetrics: true, data: { type: 'FeatureCollection', features: routeFeatures } });
        map.addLayer({
          id: 'flight-routes-hit',
          type: 'line',
          source: 'flight-routes',
          layout: { 'line-cap': 'round', 'line-join': 'round' },
          paint: { 'line-width': 14, 'line-opacity': 0 },
        });
      }
      if (surfaceFeatures.length > 0) {
        map.addSource('surface-routes', { type: 'geojson', data: { type: 'FeatureCollection', features: surfaceFeatures } });
        map.addLayer({
          id: 'surface-rail-line',
          type: 'line',
          source: 'surface-routes',
          filter: ['==', ['get', 'mode'], 'rail'],
          layout: { 'line-cap': 'round', 'line-join': 'round' },
          paint: {
            'line-color': dark ? '#deb765' : '#b88632',
            'line-width': ['interpolate', ['linear'], ['zoom'], 0, .8, 2, 1.25, 5, 1.8, 8, 2.2],
            'line-opacity': ['interpolate', ['linear'], ['zoom'], 0, .5, 2, .65, 5, .82],
          },
        });
        map.addLayer({
          id: 'surface-drive-line',
          type: 'line',
          source: 'surface-routes',
          filter: ['==', ['get', 'mode'], 'drive'],
          layout: { 'line-cap': 'round', 'line-join': 'round' },
          paint: {
            'line-color': dark ? '#719487' : '#577a6d',
            'line-width': ['interpolate', ['linear'], ['zoom'], 0, .75, 2, 1.25, 5, 2, 8, 2.4],
            'line-opacity': ['interpolate', ['linear'], ['zoom'], 0, .3, 2, .42, 5, .58],
          },
        });
        map.addLayer({
          id: 'surface-routes-hit',
          type: 'line',
          source: 'surface-routes',
          layout: { 'line-cap': 'round', 'line-join': 'round' },
          paint: { 'line-width': 16, 'line-opacity': 0 },
        });
      }
      if (airportFeatures.length > 0) {
        map.addSource('flight-airports', { type: 'geojson', data: { type: 'FeatureCollection', features: airportFeatures } });
        map.addLayer({
          id: 'flight-airports-glow',
          type: 'circle',
          source: 'flight-airports',
          paint: {
            'circle-radius': ['interpolate', ['linear'], ['get', 'visits'], 1, 6, 10, 11, 30, 16],
            'circle-color': dark ? '#7bc8fa' : '#3183b5',
            'circle-opacity': dark ? .18 : .12,
            'circle-blur': .45,
          },
        });
        map.addLayer({
          id: 'flight-airports-dot',
          type: 'circle',
          source: 'flight-airports',
          paint: {
            'circle-radius': ['interpolate', ['linear'], ['get', 'visits'], 1, 2.8, 10, 4.6, 30, 6],
            'circle-color': dark ? '#eaf7ff' : '#fff',
            'circle-stroke-color': dark ? '#68bce9' : '#176b9e',
            'circle-stroke-width': 1.5,
          },
        });
        map.addLayer({
          id: 'flight-airports-label',
          type: 'symbol',
          source: 'flight-airports',
          minzoom: 1.35,
          layout: {
            'text-field': ['get', 'code'],
            'text-size': ['interpolate', ['linear'], ['zoom'], 0, 9, 4, 11, 8, 12],
            'text-offset': [0, 1.1],
            'text-anchor': 'top',
            'text-letter-spacing': .08,
            'text-optional': true,
          },
          paint: { 'text-color': dark ? '#eef8ff' : '#173b50', 'text-halo-color': dark ? '#071019' : '#f7fbfd', 'text-halo-width': 1.4 },
        });
      }
      if (surfaceStopFeatures.length > 0) {
        map.addSource('surface-stops', { type: 'geojson', data: { type: 'FeatureCollection', features: surfaceStopFeatures } });
        map.addLayer({
          id: 'surface-stops-glow',
          type: 'circle',
          source: 'surface-stops',
          minzoom: 2.7,
          paint: { 'circle-radius': 6, 'circle-color': dark ? '#deb765' : '#b88632', 'circle-opacity': .11, 'circle-blur': .45 },
        });
        map.addLayer({
          id: 'surface-stops-dot',
          type: 'circle',
          source: 'surface-stops',
          minzoom: 2.7,
          paint: { 'circle-radius': 2.6, 'circle-color': dark ? '#f6eedb' : '#fffaf0', 'circle-stroke-color': dark ? '#deb765' : '#a87529', 'circle-stroke-width': 1.2 },
        });
        map.addLayer({
          id: 'surface-stops-label',
          type: 'symbol',
          source: 'surface-stops',
          minzoom: 4,
          layout: { 'text-field': ['get', 'title'], 'text-size': 10.5, 'text-offset': [0, 1.05], 'text-anchor': 'top', 'text-optional': true },
          paint: { 'text-color': dark ? '#f6f2e7' : '#473520', 'text-halo-color': dark ? '#071019' : '#fff', 'text-halo-width': 1.4 },
        });
      }
      if (visualArcs.length > 0) {
        map.addLayer(createArcLayer(visualArcs, dark));
        if (airportFeatures.length > 0) {
          map.moveLayer('flight-airports-glow');
          map.moveLayer('flight-airports-dot');
          map.moveLayer('flight-airports-label');
        }
      }
      if (!interactionsBound) {
        interactionsBound = true;
        const interactiveLayers = [
          routeFeatures.length > 0 ? 'flight-routes-hit' : '',
          airportFeatures.length > 0 ? 'flight-airports-dot' : '',
          surfaceFeatures.length > 0 ? 'surface-routes-hit' : '',
          surfaceStopFeatures.length > 0 ? 'surface-stops-dot' : '',
        ].filter(Boolean);
        interactiveLayers.forEach((layer) => {
          map.on('mouseenter', layer, () => { canvas.style.cursor = 'pointer'; });
          map.on('mouseleave', layer, () => { canvas.style.cursor = ''; });
        });
        if (routeFeatures.length > 0) map.on('click', 'flight-routes-hit', (event) => {
          const feature = event.features?.[0];
          const coordinates = event.lngLat;
          if (feature?.properties?.title) new maplibregl.Popup({ offset: 12 }).setLngLat(coordinates).setText(feature.properties.title).addTo(map);
        });
        if (airportFeatures.length > 0) map.on('click', 'flight-airports-dot', (event) => {
          const feature = event.features?.[0];
          if (!feature?.properties?.title) return;
          const visits = Number(feature.properties.visits ?? 0);
          new maplibregl.Popup({ offset: 12 }).setLngLat(event.lngLat)
            .setText(`${feature.properties.title}${visits ? ` · ${visits} 次起降` : ''}`).addTo(map);
        });
        if (surfaceFeatures.length > 0) map.on('click', 'surface-routes-hit', (event) => {
          const feature = event.features?.[0];
          if (!feature?.properties?.title) return;
          new maplibregl.Popup({ offset: 12 }).setLngLat(event.lngLat)
            .setText(`${feature.properties.title} · ${feature.properties.caption}`).addTo(map);
        });
        if (surfaceStopFeatures.length > 0) map.on('click', 'surface-stops-dot', (event) => {
          const feature = event.features?.[0];
          if (feature?.properties?.title) new maplibregl.Popup({ offset: 12 }).setLngLat(event.lngLat).setText(feature.properties.title).addTo(map);
        });
      }
    });
    document.addEventListener('site-theme-change', (event) => {
      const nextDark = (event as CustomEvent<string>).detail === 'dark';
      if (nextDark === dark) return;
      dark = nextDark;
      map.setStyle(`https://tiles.openfreemap.org/styles/${dark ? 'dark' : 'positron'}`);
    });
    map.on('error', () => { if (!loaded && loadStatus) loadStatus.hidden = false; });
    setTimeout(() => { if (!loaded && loadStatus) loadStatus.hidden = false; }, 7000);
  });
</script>
