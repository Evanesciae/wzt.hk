---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  brandHref?: string;
  lockViewportScale?: boolean;
}

const { title, description = site.description, brandHref = '/', lockViewportScale = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/travel/', label: 'Travel' },
  { href: '/kb/', label: 'Knowledge' },
];
const currentPath = Astro.url.pathname;
const adminSession = Astro.locals.adminSession;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content={lockViewportScale
        ? 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover'
        : 'width=device-width, initial-scale=1, viewport-fit=cover'}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        const savedMode = localStorage.getItem('site-theme-mode');
        const mode = savedMode === 'light' || savedMode === 'dark' ? savedMode : 'auto';
        const theme = mode === 'auto'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : mode;
        localStorage.removeItem('site-theme');
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {adminSession && <meta name="csrf-token" content={adminSession.csrfToken} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-brand" href={brandHref} aria-label="wzt.hk Home">
          <span class="brand-mark" aria-hidden="true">W</span>
          <span>wzt.hk</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navItems.map((item) => {
            const isActive = item.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(item.href);
            return (
              <a href={item.href} aria-current={isActive ? 'page' : undefined}>
                {item.label}
              </a>
            );
          })}
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme: System. Switch to light mode" title="Theme: System. Switch to light mode">
            <span class="theme-toggle-icon" aria-hidden="true">
              <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="13" rx="2" />
                <path d="M8 21h8M12 17v4" />
              </svg>
              <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3.5" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
              <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.4 15.5A8.5 8.5 0 0 1 8.5 3.6 8.5 8.5 0 1 0 20.4 15.5Z" />
              </svg>
            </span>
            <span data-theme-label>System</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {site.owner}</span>
        <nav aria-label="页尾导航"><a href="/links/">快速链接</a><a href="/admin/">管理</a></nav>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const toggleLabel = toggle?.querySelector<HTMLElement>('[data-theme-label]');
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

      type Theme = 'light' | 'dark';
      type ThemeMode = Theme | 'auto';

      function currentMode(): ThemeMode {
        return root.dataset.themeMode === 'light' || root.dataset.themeMode === 'dark'
          ? root.dataset.themeMode
          : 'auto';
      }

      function resolvedTheme(mode: ThemeMode): Theme {
        return mode === 'auto' ? (systemTheme.matches ? 'dark' : 'light') : mode;
      }

      function syncThemeControl() {
        const dark = root.dataset.theme === 'dark';
        const mode = currentMode();
        const nextMode: ThemeMode = mode === 'auto' ? 'light' : mode === 'light' ? 'dark' : 'auto';
        const label = mode === 'auto' ? 'System' : mode === 'light' ? 'Light' : 'Dark';
        const nextLabel = nextMode === 'auto' ? 'system' : nextMode;
        if (toggle) {
          toggle.setAttribute('aria-label', `Theme: ${label}. Switch to ${nextLabel} mode`);
          toggle.title = `Theme: ${label}. Switch to ${nextLabel} mode`;
        }
        if (toggleLabel) toggleLabel.textContent = label;
        if (meta) meta.content = dark ? '#191919' : '#ffffff';
      }

      function applyThemeMode(mode: ThemeMode, persist = true) {
        const previousTheme = root.dataset.theme;
        const theme = resolvedTheme(mode);
        root.dataset.themeMode = mode;
        root.dataset.theme = theme;
        if (persist) localStorage.setItem('site-theme-mode', mode);
        syncThemeControl();
        if (theme !== previousTheme) document.dispatchEvent(new CustomEvent('site-theme-change', { detail: theme }));
      }

      syncThemeControl();
      toggle?.addEventListener('click', () => {
        const modes: ThemeMode[] = ['auto', 'light', 'dark'];
        applyThemeMode(modes[(modes.indexOf(currentMode()) + 1) % modes.length]);
      });
      systemTheme.addEventListener('change', () => {
        if (currentMode() === 'auto') applyThemeMode('auto', false);
      });
    </script>
  </body>
</html>
